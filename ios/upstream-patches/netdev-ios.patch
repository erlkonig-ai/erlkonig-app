+#[cfg(any(target_os = "linux", target_os = "android", target_os = "ios"))]
 pub(crate) fn get_ipv6_addr_flags(_ifname: &str, _addr: &std::net::Ipv6Addr) -> Ipv6AddrFlags {
     Ipv6AddrFlags::default()
 }

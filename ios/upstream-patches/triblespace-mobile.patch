+fn every_published_prefix_has_exact_native_counts_without_a_count_worker() -> Result<()> {
+    let dir = tempfile::tempdir()?;
+    let path = dir.path().join("prefix-count-status.pile");
+    std::fs::File::create(&path)?;
+    let key = SigningKey::from_bytes(&[12; 32]);
+    let mut writer = Pile::open(&path)?;
+    let root = writer.collection("prefix counts", private_policy(key.verifying_key()))?.handle();
+    let data = writer.put::<blobencodings::UTF8String, _>("data")?;
+    let meta = writer.put::<blobencodings::SimpleArchive, _>(TribleSet::new())?;
+    writer.insert(CollectionRecord::Commit(CollectionCommit::sign(&key, root, *data.as_transmute(), meta)))?;
+    writer.flush()?;
+    let mut reader = Pile::open(&path)?;
+    let whole = reader.snapshot()?;
+    let expected = oracle(&whole, root)?;
+    // A separate writer extends the source beyond the reader's previous EOF.
+    for n in 0..32 {
+        writer.put::<blobencodings::UTF8String, _>(format!("later replay blob {n}"))?;
+    }
+    writer.flush()?;
+    let (prefix, reached_end) = reader.snapshot_step(256)?;
+    assert!(!reached_end);
+    let prefix_status = RecordCountStatus::Ready { counts: expected, replay_complete: false };
+    assert_eq!(prefix.record_count_status(root), prefix_status);
+    let sample = StorageSnapshot::begin(prefix.clone(), &[root], &[], None).map_err(anyhow::Error::msg)?;
+    assert_eq!(sample.count_status(root), Some(prefix_status.clone()));
+    assert_eq!(sample.counts(root), None, "whole-only API does not expose prefix counts");
+    let outside = Inline::new([222; 32]);
+    assert_eq!(sample.count_status(outside), None, "sample scope remains explicit");
+    let eof = reader.snapshot()?;
+    let complete = StorageSnapshot::observe(eof, &[root], &[], None).map_err(anyhow::Error::msg)?;
+    assert_eq!(complete.counts(root), Some(expected));
+    assert_eq!(complete.count_status(root), Some(RecordCountStatus::Ready { counts: expected, replay_complete: true }));
+    assert_eq!(sample.count_status(root), Some(prefix_status.clone()));
+    assert_eq!(whole.record_count_status(root), RecordCountStatus::Ready { counts: expected, replay_complete: true });
+    reader.close()?;
+    writer.close()?;
+    Ok(())
+}

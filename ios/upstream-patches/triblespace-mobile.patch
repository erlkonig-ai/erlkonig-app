+#[test]
+fn native_root_failure_preserves_mixed_sample_statuses_and_old_observation() -> Result<()> {
+    use std::convert::Infallible;
+    use std::sync::Arc;
+    use triblespace_core::repo::BlobInfo;
+
+    // A native-status-only source: consulting record or blob inventories is a
+    // defect here, not an alternative way to recover from a failed root.
+    #[derive(Clone)]
+    struct NativeStatuses(Vec<(CollectionHandle, RecordCountStatus)>);
+    impl StoreSnapshot for NativeStatuses {}
+    impl CollectionRead for NativeStatuses {
+        type RecordsError = Infallible;
+        type RecordIter<'a> = std::iter::Empty<Result<CollectionRecord, Infallible>>;
+        fn records(&self) -> Result<Self::RecordIter<'_>, Infallible> {
+            panic!("native status consumption must not rebuild canonical records")
+        }
+        fn collections(&self) -> Result<Vec<CollectionHandle>, Infallible> {
+            panic!("sample scope must not discover roots")
+        }
+        fn record_count_status(&self, root: CollectionHandle) -> RecordCountStatus {
+            self.0.iter().find(|(candidate, _)| *candidate == root)
+                .map(|(_, status)| status.clone())
+                .unwrap_or(RecordCountStatus::Untracked { replay_complete: true })
+        }
+    }
+    impl BlobStoreList for NativeStatuses {
+        type Err = Infallible;
+        type Iter<'a> = std::iter::Empty<Result<BlobInfo, Infallible>>;
+        fn blobs(&self) -> Self::Iter<'_> {
+            panic!("count failure must not trigger a blob inventory scan")
+        }
+    }
+    impl HeldRead for NativeStatuses {
+        fn held(&self, _root: CollectionHandle) -> Option<HeldBlobs> {
+            panic!("empty inventory scope must remain empty")
+        }
+        fn held_generation(&self) -> u64 { 0 }
+    }
+
+    let failed_root = Inline::new([31; 32]);
+    let healthy_root = Inline::new([32; 32]);
+    let empty_root = Inline::new([33; 32]);
+    let prefix_root = Inline::new([34; 32]);
+    let outside = Inline::new([35; 32]);
+    let healthy_counts = DirectCounts { records: 8, direct_present: 5 };
+    let prefix_counts = DirectCounts { records: 3, direct_present: 1 };
+    let failure = RecordCountStatus::Failed(Arc::from("one root's canonical selection failed"));
+    let healthy = RecordCountStatus::Ready { counts: healthy_counts, replay_complete: true };
+    let prefix = RecordCountStatus::Ready { counts: prefix_counts, replay_complete: false };
+    let source = NativeStatuses(vec![
+        (failed_root, failure.clone()),
+        (healthy_root, healthy.clone()),
+        (empty_root, RecordCountStatus::Ready { counts: DirectCounts::default(), replay_complete: true }),
+        (prefix_root, prefix.clone()),
+    ]);
+    // Failure comes first: begin must still collect every later root.
+    let scope = [failed_root, healthy_root, empty_root, prefix_root];
+    let mut sample = StorageSnapshot::begin(source.clone(), &scope, &[], None)
+        .map_err(anyhow::Error::msg)?;
+    assert_eq!(sample.count_status(failed_root), Some(failure.clone()));
+    assert_eq!(sample.count_status(healthy_root), Some(healthy.clone()));
+    assert_eq!(sample.count_status(empty_root), Some(RecordCountStatus::Ready { counts: DirectCounts::default(), replay_complete: true }));
+    assert_eq!(sample.count_status(prefix_root), Some(prefix.clone()));
+    assert_eq!(sample.count_status(outside), None);
+    assert_eq!(sample.counts(healthy_root), Some(healthy_counts));
+    assert_eq!(sample.counts(failed_root), None, "failure must not invent zero");
+    assert_eq!(sample.counts(empty_root), Some(DirectCounts::default()));
+    assert_eq!(sample.counts(prefix_root), None, "whole-only getter remains whole-only");
+    let completed = sample.step(0).map_err(anyhow::Error::msg)?.unwrap();
+    assert_eq!(completed.count_status(failed_root), Some(failure.clone()));
+    assert_eq!(completed.count_status(healthy_root), Some(healthy.clone()));
+    assert_eq!(completed.count_status(prefix_root), Some(prefix.clone()));
+    assert_eq!(completed.work(), StorageWork::default());
+
+    let recovered_counts = DirectCounts { records: 2, direct_present: 1 };
+    let recovered = RecordCountStatus::Ready { counts: recovered_counts, replay_complete: true };
+    let mut successor = source;
+    successor.0[0].1 = recovered.clone();
+    let next = StorageSnapshot::observe(successor, &scope, &[], Some(&completed))
+        .map_err(anyhow::Error::msg)?;
+    assert_eq!(next.count_status(failed_root), Some(recovered));
+    assert_eq!(next.counts(failed_root), Some(recovered_counts));
+    assert_eq!(next.count_status(healthy_root), Some(healthy));
+    assert_eq!(next.count_status(empty_root), Some(RecordCountStatus::Ready { counts: DirectCounts::default(), replay_complete: true }));
+    assert_eq!(next.count_status(prefix_root), Some(prefix));
+    assert_eq!(next.work(), StorageWork::default());
+    assert_eq!(completed.count_status(failed_root), Some(failure), "old observation is immutable");
+    Ok(())
+}

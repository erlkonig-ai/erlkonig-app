+    assert_eq!(second.counts(root), Some(DirectCounts { records: 1, direct_present: 0 }));
+    let prefix = Generic { records: vec![a], blobs: vec![[1; 32], [2; 32]], complete: false };
+    let prefix = StorageSnapshot::observe(prefix, &[root], &[], Some(&second)).map_err(anyhow::Error::msg)?;
+    assert_eq!(prefix.count_status(root), Some(RecordCountStatus::Ready {
+        counts: DirectCounts { records: 1, direct_present: 0 }, replay_complete: false,
+    }));
+    assert_eq!(prefix.counts(root), None);
+    assert_eq!(first.counts(root), Some(DirectCounts { records: 2, direct_present: 2 }));
+    Ok(())
+}

+#[test]
+fn held_deltas_scope_changes_and_two_to_one_match_oracle() -> Result<()> {
+    let dir = tempfile::tempdir()?;
+    let key = SigningKey::from_bytes(&[10; 32]);
+    let path = dir.path().join("test.pile");
+    std::fs::File::create(&path)?;
+    let mut pile = Pile::open(&path)?;
+    let roots = ["one", "two", "three"].map(|name| {
+        pile.collection(name, private_policy(key.verifying_key()))
+            .unwrap()
+            .handle()
+    });
+    let data = pile.put::<blobencodings::UTF8String, _>("shared")?;
+    let meta = pile.put::<blobencodings::SimpleArchive, _>(TribleSet::new())?;
+    for root in roots {
+        pile.insert(CollectionRecord::Commit(CollectionCommit::sign(
+            &key,
+            root,
+            *data.as_transmute(),
+            meta,
+        )))?;
+    }
+    let unknown = observe(pile.snapshot()?, &roots, &roots, None)?;
+    assert_eq!(unknown.composition().unknown_inventories, 3);
+    pile.track_held(roots);
+    pile.snapshot()?;
+    let mut work = pile.drive_held().unwrap();
+    assert!(work.run_until_idle());
+    let first = observe(pile.snapshot()?, &roots, &roots, Some(&unknown))?;
+    check_composition(&first, &roots)?;
+    let warm = observe(pile.snapshot()?, &roots, &roots, Some(&first))?;
+    assert_eq!(warm.work(), StorageWork::default());
+    let two = observe(pile.snapshot()?, &roots[..2], &roots[..2], Some(&warm))?;
+    check_composition(&two, &roots[..2])?;
+    let one = observe(pile.snapshot()?, &roots[..1], &roots[..1], Some(&two))?;
+    check_composition(&one, &roots[..1])?;
+    assert_eq!(one.composition().shared_bytes, 0);
+    let all_again = observe(pile.snapshot()?, &roots, &roots, Some(&one))?;
+    check_composition(&all_again, &roots)?;
+    let child = pile.put::<blobencodings::UTF8String, _>("late shared blob")?;
+    for root in roots {
+        pile.note_held(root, *child.as_transmute());
+    }
+    pile.snapshot()?;
+    assert!(work.run_until_idle());
+    let current = pile.snapshot()?;
+    let mut partial = StorageSnapshot::begin(current.clone(), &roots, &roots, Some(&all_again))
+        .map_err(anyhow::Error::msg)?;
+    assert!(partial.step(1).map_err(anyhow::Error::msg)?.is_none());
+    // Discarding the job cannot mutate its predecessor.
+    drop(partial);
+    check_composition(&all_again, &roots)?;
+    let after = observe(current, &roots, &roots, Some(&all_again))?;
+    assert_eq!(
+        after.work(),
+        StorageWork {
+            records_checked: 0,
+            held_memberships: 3
+        }
+    );
+    check_composition(&after, &roots)?;
+    check_composition(&first, &roots)?;
+    assert!(!first.snapshot().contains_blob(child)?);
+    assert_eq!(unknown.composition().unknown_inventories, 3);
+    let empty = observe(pile.snapshot()?, &[], &[], Some(&after))?;
+    check_composition(&empty, &[])?;
+    assert_eq!(empty.composition(), &StorageComposition::default());
+    drop(work);
+    pile.close()?;
+    Ok(())
+}

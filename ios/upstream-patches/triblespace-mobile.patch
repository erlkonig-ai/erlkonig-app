+#[test]
+fn direct_arrivals_are_incremental_and_old_snapshot_is_stable() -> Result<()> {
+    let dir = tempfile::tempdir()?;
+    let key = SigningKey::from_bytes(&[7; 32]);
+    let path = dir.path().join("test.pile");
+    std::fs::File::create(&path)?;
+    let mut pile = Pile::open(&path)?;
+    let root = pile
+        .collection("direct", private_policy(key.verifying_key()))?
+        .handle();
+    let data = IntoBlob::<blobencodings::UTF8String>::to_blob("data");
+    let meta = IntoBlob::<blobencodings::SimpleArchive>::to_blob(TribleSet::new());
+    let record = CollectionRecord::Commit(CollectionCommit::sign(
+        &key,
+        root,
+        *data.get_handle().as_transmute(),
+        meta.get_handle(),
+    ));
+    pile.insert(record)?;
+    let first = observe(pile.snapshot()?, &[root], &[], None)?;
+    assert_eq!(
+        first.counts(root),
+        Some(DirectCounts {
+            records: 1,
+            direct_present: 0
+        })
+    );
+    assert_eq!(first.work().records_checked, 0);
+    let warm = observe(pile.snapshot()?, &[root], &[], Some(&first))?;
+    assert_eq!(warm.work(), StorageWork::default());
+    pile.put::<blobencodings::UTF8String, _>("unrelated")?;
+    let unrelated = observe(pile.snapshot()?, &[root], &[], Some(&warm))?;
+    assert_eq!(unrelated.work(), StorageWork::default());
+    pile.put::<blobencodings::UTF8String, _>(data)?;
+    let data_only = observe(pile.snapshot()?, &[root], &[], Some(&unrelated))?;
+    assert_eq!(data_only.work().records_checked, 0);
+    assert_eq!(data_only.counts(root), first.counts(root));
+    pile.put::<blobencodings::SimpleArchive, _>(meta)?;
+    let full = observe(pile.snapshot()?, &[root], &[], Some(&data_only))?;
+    assert_eq!(full.work().records_checked, 0);
+    assert_eq!(full.counts(root), Some(oracle(full.snapshot(), root)?));
+    assert_eq!(full.counts(root).unwrap().direct_present, 1);
+    assert_eq!(first.counts(root).unwrap().direct_present, 0);
+    // A second assertion over the same data is distinct; replay owns its count work.
+    let other_key = SigningKey::from_bytes(&[8; 32]);
+    if let CollectionRecord::Commit(c) = record {
+        pile.insert(CollectionRecord::Commit(CollectionCommit::sign(
+            &other_key,
+            root,
+            c.data(),
+            c.metadata(),
+        )))?;
+    }
+    let second = observe(pile.snapshot()?, &[root], &[], Some(&full))?;
+    assert_eq!(second.work().records_checked, 0);
+    assert_eq!(second.counts(root), Some(oracle(second.snapshot(), root)?));
+    pile.close()?;
+    Ok(())
+}

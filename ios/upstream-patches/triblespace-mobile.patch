+use super::*;
+use crate::peer::{Peer, PeerConfig};
+use ed25519_dalek::SigningKey;
+use std::sync::{Barrier, mpsc};
+use std::thread;
+use triblespace_core::repo::memoryrepo::MemoryRepo;
+
+fn health() -> Health {
+    let key = SigningKey::from_bytes(&[1; 32]);
+    Health::new(EndpointId::from_bytes(key.verifying_key().as_bytes()).unwrap())
+}
+
+#[test]
+fn ranked_roster_keeps_peer_order_and_reconnects_replace_the_same_key() {
+    let health = health();
+    let lifetime = Arc::new(());
+    let reader = health.reader(Arc::downgrade(&lifetime));
+    let first = ConnectionHealth {
+        id: 90,
+        peer: [1; 32],
+        traffic: None,
+    };
+    let second = ConnectionHealth {
+        id: 2,
+        peer: [2; 32],
+        traffic: None,
+    };
+    let third = ConnectionHealth {
+        id: 5,
+        peer: [3; 32],
+        traffic: None,
+    };
+    health.update(|s| {
+        s.connections
+            .reconcile([first.clone(), second.clone(), third.clone()])
+    });
+    let old = reader.snapshot().unwrap();
+    assert_eq!(
+        old.connections.iter().map(|row| row.id).collect::<Vec<_>>(),
+        [90, 2, 5]
+    );
+    health.update(|s| {
+        s.connections
+            .reconcile([first.clone(), second.clone(), third.clone()])
+    });
+    assert!(Arc::ptr_eq(&old, &reader.snapshot().unwrap()));
+
+    let replacement = ConnectionHealth {
+        id: 333,
+        ..first.clone()
+    };
+    health.update(|s| {
+        s.connections
+            .reconcile([replacement.clone(), second.clone(), third.clone()])
+    });
+    let next = reader.snapshot().unwrap();
+    assert_eq!(old.connections.get(&first.peer), Some(&first));
+    assert_eq!(next.connections.get(&first.peer), Some(&replacement));
+    assert_eq!(old.connections.len(), next.connections.len());
+    assert!(!old.connections.same_root(&next.connections));
+    assert!(std::ptr::eq(
+        old.connections.get(&second.peer).unwrap(),
+        next.connections.get(&second.peer).unwrap()
+    ));
+
+    health.update(|s| s.connections.reconcile([second.clone()]));
+    let closed = reader.snapshot().unwrap();
+    assert_eq!(closed.connections.len(), 1);
+    assert!(closed.connections.get(&first.peer).is_none());
+    assert!(closed.connections.get(&third.peer).is_none());
+    assert!(std::ptr::eq(
+        next.connections.get(&second.peer).unwrap(),
+        closed.connections.get(&second.peer).unwrap()
+    ));
+    assert_eq!(old.connections.len(), 3);
+}
+
+#[test]
+fn crossed_dials_retain_both_collection_peerings_until_one_closes() {
+    let one = PeeringHealth {
+        collection: CollectionHandle::new([4; 32]),
+        peer: [5; 32],
+        connection: 7,
+        asked: true,
+        peered: false,
+        sends: false,
+        receives: false,
+        refused_by_me: false,
+        refused_by_them: false,
+    };
+    let two = PeeringHealth {
+        connection: 9,
+        peered: true,
+        ..one
+    };
+    let mut current: HealthRows<72, _> = [one, two].into_iter().collect();
+    let before = current.clone();
+    current.reconcile([two]);
+    assert_eq!(before.iter().copied().collect::<Vec<_>>(), [one, two]);
+    assert_eq!(current.iter().copied().collect::<Vec<_>>(), [two]);
+    assert!(std::ptr::eq(
+        before.get(&two.row_key()).unwrap(),
+        current.get(&two.row_key()).unwrap()
+    ));
+}
+
+#[test]
+fn value_only_updates_publish_without_mutating_prior_observations() {
+    let health = health();
+    let lifetime = Arc::new(());
+    let reader = health.reader(Arc::downgrade(&lifetime));
+    let at = crate::clock::mono_now();
+    let peer = [3; 32];
+    let resource = CollectionHandle::new([4; 32]);
+    health.update(|s| {
+        s.observed_at = Some(at);
+        s.connections.set(
+            &peer,
+            ConnectionHealth {
+                id: 42,
+                peer,
+                traffic: Some(crate::transport::TrafficStats {
+                    received_bytes: 5,
+                    sent_bytes: 0,
+                    rtt: None,
+                }),
+            },
+        );
+        s.grants.set(
+            &resource.raw,
+            GrantHealth {
+                resource,
+                local: PatchSummary::new(None, 0).unwrap(),
+                peers: [GrantPeerHealth {
+                    peer,
+                    ..Default::default()
+                }]
+                .into_iter()
+                .collect(),
+            },
+        );
+    });
+    let before = reader.snapshot().unwrap();
+    let received = |s: &HealthSnapshot| {
+        s.connections
+            .get(&peer)
+            .unwrap()
+            .traffic
+            .unwrap()
+            .received_bytes
+    };
+    let pending = |s: &HealthSnapshot| {
+        s.grants
+            .get(&resource.raw)
+            .unwrap()
+            .peers
+            .get(&peer)
+            .unwrap()
+            .pending
+    };
+    health.update(|s| {
+        s.connections.update(&peer, |row| {
+            row.traffic.as_mut().unwrap().received_bytes = 9
+        });
+    });
+    let traffic = reader.snapshot().unwrap();
+    assert!(!Arc::ptr_eq(&before, &traffic));
+    assert!(before.grants.same_root(&traffic.grants));
+    assert_eq!((received(&before), received(&traffic)), (5, 9));
+
+    health.update(|s| {
+        s.grants.update(&resource.raw, |grant| {
+            grant.peers.update(&peer, |row| row.pending = 4)
+        });
+    });
+    let grant = reader.snapshot().unwrap();
+    assert!(!Arc::ptr_eq(&traffic, &grant));
+    assert!(traffic.connections.same_root(&grant.connections));
+    assert_eq!(
+        (pending(&before), pending(&traffic), pending(&grant)),
+        (0, 0, 4)
+    );
+    assert_eq!((received(&grant), grant.observed_at), (9, Some(at)));
+
+    health.update(|s| {
+        s.grants.update(&resource.raw, |grant| {
+            grant.peers.update(&peer, |row| row.pending = 4)
+        });
+    });
+    assert!(Arc::ptr_eq(&grant, &reader.snapshot().unwrap()));
+}
+
+#[test]
+fn readers_see_complete_generations_while_writers_serialize() {
+    let health = health();
+    let lifetime = Arc::new(());
+    let reader = health.reader(Arc::downgrade(&lifetime));
+    let initial = reader.snapshot().unwrap();
+    health.update(|_| {});
+    for _ in 0..1000 {
+        assert!(Arc::ptr_eq(&initial, &reader.snapshot().unwrap()));
+    }
+
+    let start = Barrier::new(5);
+    thread::scope(|scope| {
+        for writer in 0..2 {
+            let health = &health;
+            let start = &start;
+            scope.spawn(move || {
+                start.wait();
+                for _ in 0..512 {
+                    health.update(|s| {
+                        if writer == 0 {
+                            s.publication.attempts += 1;
+                            s.publication.acknowledged += 1;
+                        } else {
+                            s.blob_serving.completed += 1;
+                            s.blob_serving.sent_bytes += 7;
+                        }
+                    });
+                }
+            });
+        }
+        for _ in 0..2 {
+            let reader = &reader;
+            let start = &start;
+            scope.spawn(move || {
+                start.wait();
+                let mut last = (0, 0);
+                for _ in 0..2000 {
+                    let s = reader.snapshot().unwrap();
+                    assert_eq!(s.publication.attempts, s.publication.acknowledged);
+                    assert_eq!(s.blob_serving.completed * 7, s.blob_serving.sent_bytes);
+                    assert!(s.publication.attempts >= last.0 && s.blob_serving.completed >= last.1);
+                    last = (s.publication.attempts, s.blob_serving.completed);
+                }
+            });
+        }
+        start.wait();
+    });
+    let end = reader.snapshot().unwrap();
+    assert_eq!(
+        (end.publication.attempts, end.blob_serving.completed),
+        (512, 512)
+    );
+    assert_eq!(
+        (initial.publication.attempts, initial.blob_serving.completed),
+        (0, 0)
+    );
+}
+
+#[test]
+fn an_in_progress_writer_does_not_hold_up_a_reader() {
+    let health = health();
+    let (entered, writing) = mpsc::channel();
+    let (resume, proceed) = mpsc::channel();
+    let initial = health.snapshot();
+    thread::scope(|scope| {
+        let health = &health;
+        scope.spawn(move || {
+            health.update(|s| {
+                s.publication.attempts = 1;
+                entered.send(()).unwrap();
+                proceed.recv_timeout(Duration::from_secs(5)).unwrap();
+                s.publication.acknowledged = 1;
+            })
+        });
+        writing.recv_timeout(Duration::from_secs(5)).unwrap();
+        assert!(Arc::ptr_eq(&initial, &health.snapshot()));
+        resume.send(()).unwrap();
+    });
+    assert_eq!(health.snapshot().publication.acknowledged, 1);
+}
+
+#[test]
+fn a_peer_reader_is_passive_and_retires_with_its_owner() {
+    let key = SigningKey::from_bytes(&[2; 32]);
+    let config = PeerConfig {
+        daemon: None,
+        provider_publication_budget: None,
+        bind: None,
+    };
+    let mut lazy = Peer::lazy(MemoryRepo::default(), key.clone(), config);
+    let reader = lazy.health_reader();
+    let before = lazy.health();
+    assert!(before.started_at.is_none() && before.observed_at.is_none());
+    assert!(Arc::ptr_eq(&before, &reader.snapshot().unwrap()));
+    assert!(reader == lazy.health_reader());
+    assert!(lazy.bound_sockets().is_empty());
+    lazy.shutdown_and_join().unwrap();
+    assert!(reader.snapshot().is_none());
+    assert!(lazy.health_reader().snapshot().is_none());
+
+    let (sender, receiver, _wiring) =
+        crate::host::wire(EndpointId::from_bytes(key.verifying_key().as_bytes()).unwrap());
+    let next = Peer::with_wiring(MemoryRepo::default(), sender.clone(), receiver);
+    let other = next.health_reader();
+    assert!(reader != other);
+    assert!(Arc::ptr_eq(&other.snapshot().unwrap(), &sender.health()));
+    drop(next.into_store());
+    assert!(
+        other.snapshot().is_none(),
+        "a retained sender cannot keep the peer alive"
+    );
+}

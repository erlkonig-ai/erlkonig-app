+    let root = pile
+        .collection("corrupt", private_policy(key.verifying_key()))?
+        .handle();
+    let payload = "unique payload for corruption fixture -- only these bytes are damaged";
+    let data = pile.put::<blobencodings::UTF8String, _>(payload)?;
+    let meta = pile.put::<blobencodings::SimpleArchive, _>(TribleSet::new())?;
+    pile.insert(CollectionRecord::Commit(CollectionCommit::sign(

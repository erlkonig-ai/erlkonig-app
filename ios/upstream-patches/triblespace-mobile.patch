+use super::*;
+use anyhow::Result;
+use ed25519_dalek::SigningKey;
+use triblespace_core::{
+    collection::{
+        CollectionCommit, CollectionDerive, CollectionRecord, CollectionRecordSelector,
+        CollectionStore, CollectionStoreExt, HeldStore, SourceLocator, private_policy,
+    },
+    prelude::*,
+    repo::{
+        BlobStorePut, SnapshotSource, StorageFlush,
+        pile::{Pile, PileSnapshot},
+    },
+};
+
+fn length(snapshot: &PileSnapshot, blob: Raw) -> Result<u64> {
+    Ok(snapshot
+        .blob_info(Inline::<inlineencodings::Handle<blobencodings::UnknownBlob>>::new(blob))?
+        .unwrap()
+        .length)
+}
+fn oracle(snapshot: &PileSnapshot, root: CollectionHandle) -> Result<DirectCounts> {
+    let records: BTreeSet<_> = snapshot
+        .select_records(&BTreeSet::from([CollectionRecordSelector::Foundations(
+            root,
+        )]))?
+        .into_iter()
+        .collect();
+    let mut direct_present = 0;
+    for record in &records {
+        if record
+            .blob_references()
+            .all(|blob| snapshot.contains_blob(blob).unwrap())
+        {
+            direct_present += 1;
+        }
+    }
+    Ok(DirectCounts {
+        records: records.len() as u64,
+        direct_present,
+    })
+}
+fn check_composition(
+    summary: &StorageSnapshot<PileSnapshot>,
+    roots: &[CollectionHandle],
+) -> Result<()> {
+    // Full scan oracle lives only in tests.
+    let snapshot = summary.snapshot();
+    let mut owners = std::collections::BTreeMap::<Raw, Vec<Raw>>::new();
+    let mut known = 0;
+    for root in roots {
+        if let Some(held) = snapshot.held(*root) {
+            known += 1;
+            let mut bytes = 0;
+            for blob in held.iter() {
+                bytes += length(snapshot, *blob)?;
+                owners.entry(*blob).or_default().push(root.raw);
+            }
+            assert_eq!(summary.resident_bytes(*root), Some(bytes));
+        } else {
+            assert_eq!(summary.resident_bytes(*root), None);
+        }
+    }
+    let mut union = 0;
+    let mut shared = 0;
+    let mut exclusive = std::collections::BTreeMap::<Raw, u64>::new();
+    for (blob, roots) in owners {
+        let bytes = length(snapshot, blob)?;
+        union += bytes;
+        if roots.len() > 1 {
+            shared += bytes;
+        } else {
+            *exclusive.entry(roots[0]).or_default() += bytes;
+        }
+    }
+    assert_eq!(
+        summary.composition(),
+        &StorageComposition {
+            known_bytes: union,
+            shared_bytes: shared,
+            known_inventories: known,
+            unknown_inventories: roots.len() - known
+        }
+    );
+    for root in roots {
+        if snapshot.held(*root).is_some() {
+            assert_eq!(
+                summary.exclusive_bytes(*root),
+                Some(exclusive.get(&root.raw).copied().unwrap_or(0))
+            );
+        }
+    }
+    Ok(())
+}
+fn observe(
+    snapshot: PileSnapshot,
+    records: &[CollectionHandle],
+    roots: &[CollectionHandle],
+    old: Option<&StorageSnapshot<PileSnapshot>>,
+) -> Result<StorageSnapshot<PileSnapshot>> {
+    StorageSnapshot::observe(snapshot, records, roots, old).map_err(anyhow::Error::msg)
+}

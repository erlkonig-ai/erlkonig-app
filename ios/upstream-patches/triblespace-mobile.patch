+#[derive(Clone)]
+struct FaultInventory {
+    enumerations: std::sync::Arc<std::sync::atomic::AtomicUsize>,
+    held: triblespace_core::collection::HeldBlobs,
+    blobs: Vec<triblespace_core::repo::BlobInfo>,
+}
+impl triblespace_core::repo::StoreSnapshot for FaultInventory {}
+impl CollectionRead for FaultInventory {
+    type RecordsError = std::convert::Infallible;
+    type RecordIter<'a> = std::iter::Empty<Result<CollectionRecord, Self::RecordsError>>;
+    fn records(&self) -> Result<Self::RecordIter<'_>, Self::RecordsError> {
+        Ok(std::iter::empty())
+    }
+    fn collections(&self) -> Result<Vec<CollectionHandle>, Self::RecordsError> {
+        Ok(Vec::new())
+    }
+}
+impl BlobStoreList for FaultInventory {
+    type Err = std::convert::Infallible;
+    type Iter<'a> = std::vec::IntoIter<Result<triblespace_core::repo::BlobInfo, Self::Err>>;
+    fn blobs(&self) -> Self::Iter<'_> {
+        self.enumerations
+            .fetch_add(1, std::sync::atomic::Ordering::SeqCst);
+        self.blobs
+            .iter()
+            .copied()
+            .map(Ok)
+            .collect::<Vec<_>>()
+            .into_iter()
+    }
+    fn blob_info<E>(
+        &self,
+        handle: Inline<inlineencodings::Handle<E>>,
+    ) -> Result<Option<triblespace_core::repo::BlobInfo>, Self::Err>
+    where
+        E: triblespace_core::blob::BlobEncoding + 'static,
+        inlineencodings::Handle<E>: triblespace_core::inline::InlineEncoding,
+    {
+        Ok(self
+            .blobs
+            .iter()
+            .find(|info| info.handle.raw == handle.raw)
+            .copied())
+    }
+}
+impl HeldRead for FaultInventory {
+    fn held(&self, _: CollectionHandle) -> Option<triblespace_core::collection::HeldBlobs> {
+        Some(self.held.clone())
+    }
+    fn held_generation(&self) -> u64 {
+        0
+    }
+}

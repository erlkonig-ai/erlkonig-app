+//! Incremental local storage statistics pinned to one immutable store snapshot.
+//!
+//! Scope is supplied by the caller after its own access checks. This module
+//! neither grants access nor selects/activates collections. Canonical records
+//! reuse the repair PATCH; held membership reuses the store's published PATCHs.
+//! Only derived aggregates and missing-reference routes are retained. No state
+//! is persisted, and no blob body is fetched or traversed here.
+use crate::collection_delta::{
+    CollectionRecordPatch, collection_record_patch, update_collection_record_patch,
+};
+use std::collections::BTreeSet;
+use std::fmt::Display;
+use triblespace_core::{
+    blob::encodings::UnknownBlob,
+    collection::{CollectionHandle, CollectionRead, HeldBlobs, HeldRead},
+    inline::{Inline, encodings::hash::Handle},
+    patch::{Entry, IdentitySchema, PATCH},
+    repo::{BlobStoreList, StoreChanges, StoreSnapshot},
+};
+
+type Raw = [u8; 32];
+type Handles = PATCH<32, IdentitySchema>;
+mod dependency {
+    triblespace_core::key_segmentation!(Segments, 64, [32, 32]);
+    triblespace_core::key_schema!(Schema, Segments, 64, [0, 1]);
+}
+type Waiting = PATCH<64, dependency::Schema>;
+fn pair(blob: Raw, record: Raw) -> [u8; 64] {
+    let mut key = [0; 64];
+    key[..32].copy_from_slice(&blob);
+    key[32..].copy_from_slice(&record);
+    key
+}
+fn handle(raw: Raw) -> Inline<Handle<UnknownBlob>> {
+    Inline::new(raw)
+}
+
+pub use triblespace_core::collection::record_counts::DirectCounts;
+use triblespace_core::collection::record_counts::RecordCountStatus;
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct StorageWork {
+    /// Canonical records whose direct references were examined in this advance.
+    pub records_checked: u64,
+    /// Added/removed held memberships visited, not the complete inventory.
+    pub held_memberships: u64,
+}
+#[derive(Clone)]
+struct Direct {
+    records: CollectionRecordPatch,
+    present: Handles,
+    waiting: Waiting,
+}
+impl Direct {
+    fn references(&self, id: &Raw) -> Vec<Raw> {
+        if let Some(record) = self.records.commits().get(id) {
+            vec![
+                record.collection().raw,
+                record.data().raw,
+                record.metadata().raw,
+            ]
+        } else if let Some(record) = self.records.derives().get(id) {
+            // The DERIVE source locator is not a blob reference.
+            vec![record.target().raw, record.output().raw]
+        } else {
+            Vec::new()
+        }
+    }
+    fn check<R: BlobStoreList>(
+        &mut self,
+        snapshot: &R,
+        id: Raw,
+        work: &mut StorageWork,
+    ) -> Result<(), String>
+    where
+        R::Err: Display,
+    {
+        work.records_checked += 1;
+        let mut present = true;
+        for blob in self.references(&id) {
+            let route = pair(blob, id);
+            if snapshot
+                .contains_blob(handle(blob))
+                .map_err(|e| e.to_string())?
+            {
+                self.waiting.remove(&route);
+            } else {
+                present = false;
+                self.waiting.insert(&Entry::new(&route));
+            }
+        }
+        if present {
+            self.present.insert(&Entry::new(&id));
+        } else {
+            self.present.remove(&id);
+        }
+        Ok(())
+    }
+    fn counts(&self) -> DirectCounts {
+        DirectCounts {
+            records: self.records.len(),
+            direct_present: self.present.len(),
+        }
+    }
+}
+#[derive(Clone)]
+struct Inventory {
+    held: HeldBlobs,
+    bytes: u64,
+}
+#[derive(Clone, Copy, Default)]
+struct Ownership {
+    count: u64,
+    // Reversible aggregate of the distinct collection handles. Only interpreted
+    // when count == 1, when it is exactly the sole owner, not a hash identity.
+    owner_xor: Raw,
+}
+#[derive(Clone, Debug, Default, PartialEq, Eq)]
+pub struct StorageComposition {
+    pub known_bytes: u64,
+    pub shared_bytes: u64,
+    pub known_inventories: usize,
+    pub unknown_inventories: usize,
+}
+
+/// An immutable observation and its derived statistics. Advancing returns a
+/// new value; old observations retain their original source and PATCH roots.
+#[derive(Clone)]
+pub struct StorageSnapshot<R> {
+    snapshot: R,
+    direct: PATCH<32, IdentitySchema, Direct>,
+    count_statuses: PATCH<32, IdentitySchema, RecordCountStatus>,
+    inventories: PATCH<32, IdentitySchema, Inventory>,
+    ownership: PATCH<32, IdentitySchema, Ownership>,
+    exclusive: PATCH<32, IdentitySchema, u64>,
+    composition: StorageComposition,
+    work: StorageWork,
+}
+impl<R> StorageSnapshot<R>
+where
+    R: StoreSnapshot + CollectionRead + BlobStoreList + HeldRead,
+    R::RecordsError: Display,
+    R::Err: Display,
+{
+    /// Build or advance requested record statistics and the exact inventory
+    /// scope. An empty scope is empty, not permission to discover other roots.
+    /// Initial construction visits selected records/inventories once. Warm
+    /// construction uses canonical record and held-set differences.
+    pub fn observe(
+        snapshot: R,
+        record_roots: &[CollectionHandle],
+        inventory_roots: &[CollectionHandle],
+        previous: Option<&Self>,
+    ) -> Result<Self, String> {
+        let mut sample = Self::begin(snapshot, record_roots, inventory_roots, previous)?;
+        loop {
+            if let Some(snapshot) = sample.step(4096)? {
+                return Ok(snapshot);
+            }
+        }
+    }
+
+    /// Read owner-maintained counts and prepare native byte-difference cursors.
+    /// Native roots share their exact count status, including replay
+    /// prefixes; this sample never warms or duplicates their canonical state.
+    /// Explicitly requested untracked roots retain the cold canonical fallback
+    /// and carry their source's replay-completion flag into its result. Resident
+    /// byte work is cooperative and bounded by `StorageSample::step`.
+    pub fn begin(
+        snapshot: R,
+        record_roots: &[CollectionHandle],
+        inventory_roots: &[CollectionHandle],
+        previous: Option<&Self>,
+    ) -> Result<StorageSample<R>, String> {
+        let mut next = Self {
+            snapshot,
+            direct: PATCH::new(),
+            count_statuses: PATCH::new(),
+            inventories: PATCH::new(),
+            ownership: previous.map_or_else(PATCH::new, |p| p.ownership.clone()),
+            exclusive: previous.map_or_else(PATCH::new, |p| p.exclusive.clone()),
+            composition: previous
+                .map_or_else(StorageComposition::default, |p| p.composition.clone()),
+            work: StorageWork::default(),
+        };
+        // One residency delta for this advance. Loss requires rebuilding direct
+        // availability; indexed presence is intentionally not payload validity.
+        let mut arrived = Handles::new();
+        let mut lost = false;
+        let local_roots: BTreeSet<_> = record_roots.iter().copied().filter(|root| {
+            matches!(next.snapshot.record_count_status(*root), RecordCountStatus::Untracked { .. })
+        }).collect();
+        for root in record_roots {
+            let status = next.snapshot.record_count_status(*root);
+            // Native count failure belongs to this root. Preserve it beside
+            // other Ready roots; it is not a byte-sample failure.
+            next.count_statuses.insert(&Entry::with_value(&root.raw, status));
+        }
+        if let Some(old) = previous.filter(|_| !local_roots.is_empty()) {
+            if next
+                .snapshot
+                .changes_since(&old.snapshot)
+                .contains(StoreChanges::BLOBS)
+            {
+                for info in next.snapshot.blobs_diff(&old.snapshot) {
+                    let info = info.map_err(|e| e.to_string())?;
+                    if !old
+                        .snapshot
+                        .contains_blob(info.handle)
+                        .map_err(|e| e.to_string())?
+                    {
+                        arrived.insert(&Entry::new(&info.handle.raw));
+                    }
+                }
+                for info in old.snapshot.blobs_diff(&next.snapshot) {
+                    let info = info.map_err(|e| e.to_string())?;
+                    if !next
+                        .snapshot
+                        .contains_blob(info.handle)
+                        .map_err(|e| e.to_string())?
+                    {
+                        lost = true;
+                        break;
+                    }
+                }
+            }
+        }
+        for root in local_roots {
+            let old = previous.and_then(|p| p.direct.get(&root.raw));
+            // The native updater checks source lineage before occurrence-key
+            // algebra and rebuilds for incomparable origins. Only its resulting
+            // canonical PATCHs are compared below, never physical coordinates.
+            let records = match (previous, old) {
+                (Some(p), Some(d)) => {
+                    update_collection_record_patch(&next.snapshot, &p.snapshot, &d.records)
+                }
+                _ => collection_record_patch(&next.snapshot, root),
+            }
+            .map_err(|e| e.to_string())?;
+            let mut state = Direct {
+                records,
+                present: Handles::new(),
+                waiting: Waiting::new(),
+            };
+            let mut check = Handles::new();
+            if let Some(old) = old.filter(|_| !lost) {
+                state.present = old.present.clone();
+                state.waiting = old.waiting.clone();
+                for id in old
+                    .records
+                    .commits()
+                    .difference(state.records.commits())
+                    .iter()
+                    .chain(
+                        old.records
+                            .derives()
+                            .difference(state.records.derives())
+                            .iter(),
+                    )
+                {
+                    state.present.remove(id);
+                    for blob in old.references(id) {
+                        state.waiting.remove(&pair(blob, *id));
+                    }
+                }
+                for id in state
+                    .records
+                    .commits()
+                    .difference(old.records.commits())
+                    .iter()
+                    .chain(
+                        state
+                            .records
+                            .derives()
+                            .difference(old.records.derives())
+                            .iter(),
+                    )
+                {
+                    check.insert(&Entry::new(id));
+                }
+                for blob in arrived.iter() {
+                    state.waiting.infixes(blob, |id: &Raw| {
+                        check.insert(&Entry::new(id));
+                    });
+                }
+            } else {
+                for id in state
+                    .records
+                    .commits()
+                    .iter()
+                    .chain(state.records.derives().iter())
+                {
+                    check.insert(&Entry::new(id));
+                }
+            }
+            for id in check.iter() {
+                state.check(&next.snapshot, *id, &mut next.work)?;
+            }
+            let replay_complete = match next.count_statuses.get(&root.raw) {
+                Some(RecordCountStatus::Untracked { replay_complete }) => *replay_complete,
+                _ => unreachable!("local roots are explicitly untracked"),
+            };
+            next.count_statuses.replace(&Entry::with_value(&root.raw, RecordCountStatus::Ready {
+                counts: state.counts(), replay_complete,
+            }));
+            next.direct.insert(&Entry::with_value(&root.raw, state));
+        }
+        // Hold the native immutable inventory roots, not copies of their rows.
+        let roots: BTreeSet<_> = inventory_roots.iter().copied().collect();
+        next.composition.known_inventories = 0;
+        next.composition.unknown_inventories = 0;
+        for root in &roots {
+            if let Some(held) = next.snapshot.held(*root) {
+                let bytes = previous
+                    .and_then(|p| p.inventories.get(&root.raw))
+                    .map_or(0, |i| i.bytes);
+                next.inventories
+                    .insert(&Entry::with_value(&root.raw, Inventory { held, bytes }));
+                next.composition.known_inventories += 1;
+            } else {
+                next.composition.unknown_inventories += 1;
+            }
+        }
+        let mut jobs = Vec::new();
+        if let Some(old) = previous {
+            for root in old.inventories.iter() {
+                let before = old.inventories.get(root).unwrap();
+                let removed = match next.inventories.get(root) {
+                    Some(after) => before.held.difference(&after.held),
+                    None => before.held.clone(),
+                };
+                if !removed.is_empty() {
+                    jobs.push(StorageJob {
+                        root: *root,
+                        add: false,
+                        handles: Box::new(removed.into_iter_ordered()),
+                    });
+                }
+            }
+        }
+        for root in next.inventories.iter() {
+            let after = next.inventories.get(root).unwrap();
+            let added = match previous.and_then(|p| p.inventories.get(root)) {
+                Some(before) => after.held.difference(&before.held),
+                None => after.held.clone(),
+            };
+            if !added.is_empty() {
+                jobs.push(StorageJob {
+                    root: *root,
+                    add: true,
+                    handles: Box::new(added.into_iter_ordered()),
+                });
+            }
+        }
+        Ok(StorageSample {
+            next: Some(next),
+            previous: previous.map(|p| p.snapshot.clone()),
+            jobs,
+            cursor: 0,
+        })
+    }
+    fn length(snapshot: &R, blob: Raw) -> Result<u64, String> {
+        snapshot
+            .blob_info(handle(blob))
+            .map_err(|e| e.to_string())?
+            .map(|info| info.length)
+            .ok_or_else(|| "Held content absent from sampled index".into())
+    }
+    fn adjust(value: &mut u64, bytes: u64, add: bool) -> Result<(), String> {
+        *value = if add {
+            value.checked_add(bytes)
+        } else {
+            value.checked_sub(bytes)
+        }
+        .ok_or_else(|| "Storage byte count overflow or inconsistent delta".to_owned())?;
+        Ok(())
+    }
+    fn exclusive_adjust(&mut self, root: Raw, bytes: u64, add: bool) -> Result<(), String> {
+        let mut value = self.exclusive.get(&root).copied().unwrap_or(0);
+        Self::adjust(&mut value, bytes, add)?;
+        self.exclusive.replace(&Entry::with_value(&root, value));
+        Ok(())
+    }
+    fn membership(&mut self, root: Raw, blob: Raw, bytes: u64, add: bool) -> Result<(), String> {
+        self.work.held_memberships += 1;
+        if let Some(mut inventory) = self.inventories.get(&root).cloned() {
+            Self::adjust(&mut inventory.bytes, bytes, add)?;
+            self.inventories
+                .replace(&Entry::with_value(&root, inventory));
+        }
+        let mut owner = self.ownership.get(&blob).copied().unwrap_or_default();
+        if owner.count == 1 {
+            self.exclusive_adjust(owner.owner_xor, bytes, false)?;
+        } else if owner.count >= 2 {
+            Self::adjust(&mut self.composition.shared_bytes, bytes, false)?;
+        }
+        if owner.count == 0 {
+            Self::adjust(&mut self.composition.known_bytes, bytes, true)?;
+        }
+        Self::adjust(&mut owner.count, 1, add)?;
+        for (a, b) in owner.owner_xor.iter_mut().zip(root) {
+            *a ^= b;
+        }
+        if owner.count == 0 {
+            Self::adjust(&mut self.composition.known_bytes, bytes, false)?;
+            self.ownership.remove(&blob);
+        } else {
+            if owner.count == 1 {
+                self.exclusive_adjust(owner.owner_xor, bytes, true)?;
+            } else {
+                Self::adjust(&mut self.composition.shared_bytes, bytes, true)?;
+            }
+            self.ownership.replace(&Entry::with_value(&blob, owner));
+        }
+        Ok(())
+    }
+    pub fn snapshot(&self) -> &R {
+        &self.snapshot
+    }
+    /// Exact count state for a requested root; None outside this sample's
+    /// explicit scope. Ready prefix counts retain `replay_complete: false`.
+    pub fn count_status(&self, root: CollectionHandle) -> Option<RecordCountStatus> {
+        self.count_statuses.get(&root.raw).cloned()
+    }
+    /// Full-replay counts for callers requiring the previous whole-store
+    /// contract. Prefix-aware callers use `count_status` instead.
+    pub fn counts(&self, root: CollectionHandle) -> Option<DirectCounts> {
+        match self.count_status(root)? {
+            RecordCountStatus::Ready { counts, replay_complete: true } => Some(counts),
+            _ => None,
+        }
+    }
+    pub fn resident_bytes(&self, root: CollectionHandle) -> Option<u64> {
+        self.inventories.get(&root.raw).map(|i| i.bytes)
+    }
+    pub fn exclusive_bytes(&self, root: CollectionHandle) -> Option<u64> {
+        self.inventories
+            .get(&root.raw)
+            .map(|_| self.exclusive.get(&root.raw).copied().unwrap_or(0))
+    }
+    pub fn composition(&self) -> &StorageComposition {
+        &self.composition
+    }
+    pub fn work(&self) -> StorageWork {
+        self.work
+    }
+}
+
+struct StorageJob {
+    root: Raw,
+    add: bool,
+    handles: Box<dyn Iterator<Item = Raw>>,
+}
+/// A disposable, bounded byte-aggregate update. No partial summary escapes.
+/// Dropping this job preserves the previous completed observation unchanged.
+pub struct StorageSample<R> {
+    next: Option<StorageSnapshot<R>>,
+    previous: Option<R>,
+    jobs: Vec<StorageJob>,
+    cursor: usize,
+}
+impl<R> StorageSample<R>
+where
+    R: StoreSnapshot + CollectionRead + BlobStoreList + HeldRead,
+    R::RecordsError: Display,
+    R::Err: Display,
+{
+    /// Exact count state for a requested root of this pinned observation,
+    /// including computed replay prefixes. This never drives native work.
+    pub fn count_status(&self, root: CollectionHandle) -> Option<RecordCountStatus> {
+        self.next.as_ref()?.count_status(root)
+    }
+
+    /// Full-replay direct-record counts from this job's pinned snapshot, if ready.
+    /// Pending native roots and computed prefixes return None. This never
+    /// drives native count work or publishes unfinished byte aggregates. Use
+    /// `count_status` to display exact prefix counts with their incomplete flag.
+    pub fn counts(&self, root: CollectionHandle) -> Option<DirectCounts> {
+        self.next.as_ref()?.counts(root)
+    }
+
+    /// An error is terminal: any partially updated aggregate is discarded.
+    /// Calling again after an error or completion cannot publish a result.
+    pub fn step(&mut self, budget: usize) -> Result<Option<StorageSnapshot<R>>, String> {
+        let result = self.step_inner(budget);
+        if result.is_err() {
+            self.next = None;
+        }
+        result
+    }
+    fn step_inner(&mut self, mut budget: usize) -> Result<Option<StorageSnapshot<R>>, String> {
+        let next = self
+            .next
+            .as_mut()
+            .ok_or_else(|| "Storage sample already finished".to_owned())?;
+        while self.cursor < self.jobs.len() {
+            if budget == 0 {
+                return Ok(None);
+            }
+            let job = &mut self.jobs[self.cursor];
+            if let Some(blob) = job.handles.next() {
+                budget -= 1;
+                let source = if job.add {
+                    &next.snapshot
+                } else {
+                    self.previous.as_ref().expect("removals have a predecessor")
+                };
+                let bytes = StorageSnapshot::length(source, blob)?;
+                next.membership(job.root, blob, bytes, job.add)?;
+            } else {
+                self.cursor += 1;
+            }
+        }
+        let gone: Vec<_> = next
+            .exclusive
+            .iter()
+            .filter(|root| next.inventories.get(root).is_none())
+            .copied()
+            .collect();
+        for root in gone {
+            next.exclusive.remove(&root);
+        }
+        Ok(self.next.take())
+    }
+}

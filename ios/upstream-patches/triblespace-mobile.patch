@@ -0,0 +1,131 @@
+use std::fmt;
+use triblespace_core::patch::{Entry, IdentitySchema, PATCH, PATCHEntriesOrderedIterator};
+
+/// Immutable health observations share their ordered PATCH rows. Keys give
+/// the reporting order. Attached counters and flags are part of row equality.
+#[derive(Clone)]
+pub struct HealthRows<const N: usize, T>(PATCH<N, IdentitySchema, T>);
+
+impl<const N: usize, T> Default for HealthRows<N, T> {
+    fn default() -> Self {
+        Self(PATCH::new())
+    }
+}
+
+impl<const N: usize, T> HealthRows<N, T> {
+    pub fn len(&self) -> usize {
+        self.0.len() as usize
+    }
+    pub fn is_empty(&self) -> bool {
+        self.0.is_empty()
+    }
+    pub fn get(&self, key: &[u8; N]) -> Option<&T> {
+        self.0.get(key)
+    }
+    pub fn same_root(&self, other: &Self) -> bool {
+        self.0.shares_root(&other.0)
+    }
+    pub fn iter(&self) -> impl ExactSizeIterator<Item = &T> {
+        self.into_iter()
+    }
+}
+
+pub struct RowsIter<'a, const N: usize, T>(PATCHEntriesOrderedIterator<'a, N, IdentitySchema, T>);
+impl<'a, const N: usize, T> Iterator for RowsIter<'a, N, T> {
+    type Item = &'a T;
+    fn next(&mut self) -> Option<Self::Item> {
+        self.0.next().map(|(_, row)| row)
+    }
+    fn size_hint(&self) -> (usize, Option<usize>) {
+        self.0.size_hint()
+    }
+}
+impl<const N: usize, T> ExactSizeIterator for RowsIter<'_, N, T> {}
+impl<'a, const N: usize, T> IntoIterator for &'a HealthRows<N, T> {
+    type Item = &'a T;
+    type IntoIter = RowsIter<'a, N, T>;
+    fn into_iter(self) -> Self::IntoIter {
+        RowsIter(self.0.iter_entries_ordered())
+    }
+}
+
+impl<const N: usize, T: fmt::Debug> fmt::Debug for HealthRows<N, T> {
+    fn fmt(&self, out: &mut fmt::Formatter<'_>) -> fmt::Result {
+        out.debug_list().entries(self).finish()
+    }
+}
+impl<const N: usize, T: PartialEq> PartialEq for HealthRows<N, T> {
+    fn eq(&self, other: &Self) -> bool {
+        self.same_root(other)
+            || (self.len() == other.len()
+                && self
+                    .0
+                    .iter_entries_ordered()
+                    .eq(other.0.iter_entries_ordered()))
+    }
+}
+impl<const N: usize, T: Eq> Eq for HealthRows<N, T> {}
+
+impl<const N: usize, T: PartialEq> HealthRows<N, T> {
+    pub(crate) fn set(&mut self, key: &[u8; N], row: T) {
+        if self.get(key) != Some(&row) {
+            self.0.replace(&Entry::with_value(key, row));
+        }
+    }
+    pub(crate) fn remove(&mut self, key: &[u8; N]) {
+        self.0.remove(key);
+    }
+}
+impl<const N: usize, T: Clone + PartialEq> HealthRows<N, T> {
+    #[cfg(test)]
+    pub(crate) fn update_first(&mut self, change: impl FnOnce(&mut T)) {
+        let key = *self.0.iter_ordered().next().expect("nonempty fixture");
+        self.update(&key, change);
+    }
+    pub(crate) fn update(&mut self, key: &[u8; N], change: impl FnOnce(&mut T)) {
+        if let Some(mut row) = self.get(key).cloned() {
+            change(&mut row);
+            self.set(key, row);
+        }
+    }
+}
+
+/// Stable index key in this health view.
+pub trait RowKey<const N: usize> {
+    fn row_key(&self) -> [u8; N];
+}
+impl<const N: usize, T: RowKey<N> + PartialEq> FromIterator<T> for HealthRows<N, T> {
+    fn from_iter<I: IntoIterator<Item = T>>(rows: I) -> Self {
+        let mut result = Self::default();
+        for row in rows {
+            result.set(&row.row_key(), row);
+        }
+        result
+    }
+}
+
+impl<const N: usize, T: RowKey<N> + PartialEq + Clone> HealthRows<N, T> {
+    pub fn insert(&mut self, row: T) {
+        self.set(&row.row_key(), row);
+    }
+
+    /// Reconcile an observation in the producer's existing key order. Keep
+    /// untouched leaves (and the entire root on a quiet sample).
+    pub(crate) fn reconcile(&mut self, rows: impl IntoIterator<Item = T>) {
+        let previous = self.clone();
+        let mut old = previous.0.iter_ordered().peekable();
+        for row in rows {
+            let key = row.row_key();
+            while old.peek().is_some_and(|prior| **prior < key) {
+                self.remove(old.next().unwrap());
+            }
+            if old.peek().is_some_and(|prior| **prior == key) {
+                old.next();
+            }
+            self.set(&key, row);
+        }
+        for key in old {
+            self.remove(key);
+        }
+    }
+}

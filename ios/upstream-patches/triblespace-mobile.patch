+#[test]
+fn ready_counts_precede_large_byte_job_and_stay_on_the_pinned_snapshot() -> Result<()> {
+    let dir = tempfile::tempdir()?;
+    let path = dir.path().join("ready-counts.pile");
+    std::fs::File::create(&path)?;
+    let key = SigningKey::from_bytes(&[12; 32]);
+    let mut pile = Pile::open(&path)?;
+    let root = pile.collection("ready counts", private_policy(key.verifying_key()))?.handle();
+    let data = pile.put::<blobencodings::UTF8String, _>("direct data")?;
+    let meta = pile.put::<blobencodings::SimpleArchive, _>(TribleSet::new())?;
+    pile.insert(CollectionRecord::Commit(CollectionCommit::sign(
+        &key, root, *data.as_transmute(), meta,
+    )))?;
+    pile.track_held([root]);
+    // Many tiny members exceed the production per-turn budget without a
+    // large allocation or payload. Their bytes are not read by statistics.
+    for index in 0..4100 {
+        let blob = pile.put::<blobencodings::UTF8String, _>(format!("held {index}"))?;
+        pile.note_held(root, *blob.as_transmute());
+    }
+    pile.snapshot()?;
+    let mut work = pile.drive_held().unwrap();
+    assert!(work.run_until_idle());
+    let before = pile.snapshot()?;
+    assert!(before.held(root).unwrap().len() > 4096);
+    let expected = oracle(&before, root)?;
+    let mut sample = StorageSnapshot::begin(before.clone(), &[root], &[root], None)
+        .map_err(anyhow::Error::msg)?;
+    assert_eq!(sample.counts(root), Some(expected));
+    assert!(sample.step(4096).map_err(anyhow::Error::msg)?.is_none());
+
+    // Another writer's record changes the live source, not this observation.
+    let other = SigningKey::from_bytes(&[13; 32]);
+    pile.insert(CollectionRecord::Commit(CollectionCommit::sign(
+        &other, root, *data.as_transmute(), meta,
+    )))?;
+    let after = pile.snapshot()?;
+    assert_eq!(oracle(&after, root)?.records, expected.records + 1);
+    assert_eq!(sample.counts(root), Some(expected));
+    let complete = sample.step(4096).map_err(anyhow::Error::msg)?.unwrap();
+    assert_eq!(complete.counts(root), Some(expected));
+    check_composition(&complete, &[root])?;
+    assert_eq!(sample.counts(root), None);
+
+    let unchanged = observe(before, &[root], &[root], Some(&complete))?;
+    assert_eq!(unchanged.work(), StorageWork::default());
+    let advanced = observe(after, &[root], &[root], Some(&complete))?;
+    assert_eq!(advanced.counts(root).unwrap().records, expected.records + 1);
+    assert_eq!(advanced.work().records_checked, 0);
+    pile.close()?;
+    Ok(())
+}

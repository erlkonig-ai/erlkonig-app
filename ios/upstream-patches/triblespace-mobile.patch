diff --git a/triblespace-core/src/collection/record_counts.rs b/triblespace-core/src/collection/record_counts.rs
new file mode 100644
--- /dev/null
+++ b/triblespace-core/src/collection/record_counts.rs
@@ -0,0 +1,131 @@
+//! Exact native counts maintained at the same frame boundary as pile replay.
+//!
+//! Canonical foundation views share their mapped bytes with the occurrence
+//! index. Only missing direct references need reverse routes: native pile
+//! lineages are append-only, so the first indexed blob consumes its routes.
+//! No UI scope, worker, cold seed, or count publication scheduler is involved.
+
+use std::sync::Arc;
+use crate::patch::{Entry, IdentitySchema, PATCH};
+use super::{CollectionHandle, CollectionRecordView};
+use super::record_patch::{CollectionRecordPatch, insert_record};
+
+type Raw = [u8; 32];
+mod dependency {
+    crate::key_segmentation!(Segments, 96, [32, 32, 32]);
+    crate::key_schema!(Schema, Segments, 96, [0, 1, 2]);
+}
+type Missing = PATCH<96, dependency::Schema>;
+
+#[derive(Clone, Copy, Debug, Default, PartialEq, Eq)]
+pub struct DirectCounts {
+    /// Distinct canonical COMMIT/DERIVE assertions, not produced members.
+    pub records: u64,
+    /// Assertions whose directly named blobs are indexed locally.
+    pub direct_present: u64,
+}
+
+/// Counts refer to this exact immutable observation, including replay prefixes.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum RecordCountStatus {
+    /// A generic backend without native counts; scoped canonical fallback is allowed.
+    Untracked { replay_complete: bool },
+    Ready { counts: DirectCounts, replay_complete: bool },
+    Failed(Arc<str>),
+}
+
+#[derive(Clone, Debug)]
+struct Root {
+    records: CollectionRecordPatch,
+    direct_present: u64,
+    error: Option<Arc<str>>,
+}
+impl Root {
+    fn new(root: CollectionHandle) -> Self {
+        Self { records: CollectionRecordPatch::empty(root), direct_present: 0, error: None }
+    }
+    fn references(&self, id: &Raw) -> Vec<Raw> {
+        if let Some(record) = self.records.commits().get(id) {
+            vec![record.collection().raw, record.data().raw, record.metadata().raw]
+        } else if let Some(record) = self.records.derives().get(id) {
+            // The source locator is not a blob handle.
+            vec![record.target().raw, record.output().raw]
+        } else { Vec::new() }
+    }
+}
+
+/// Derived native index, cloned with the other persistent pile roots.
+#[derive(Clone, Debug, Default)]
+pub(crate) struct RecordCountIndex {
+    roots: PATCH<32, IdentitySchema, Root>,
+    missing: Missing,
+}
+impl RecordCountIndex {
+    pub(crate) fn status(&self, root: CollectionHandle) -> RecordCountStatus {
+        let counts = match self.roots.get(&root.raw) {
+            Some(state) => {
+                if let Some(error) = &state.error { return RecordCountStatus::Failed(Arc::clone(error)); }
+                DirectCounts { records: state.records.len(), direct_present: state.direct_present }
+            }
+            None => DirectCounts::default(),
+        };
+        RecordCountStatus::Ready { counts, replay_complete: true }
+    }
+    pub(crate) fn records(&self, root: CollectionHandle) -> Option<&CollectionRecordPatch> {
+        let state = self.roots.get(&root.raw)?;
+        if state.error.is_some() { None } else { Some(&state.records) }
+    }
+    /// Called only for decoded native COMMIT/DERIVE bodies. Root-local
+    /// canonical failure never changes whether another root can be observed.
+    pub(crate) fn record(&mut self, record: CollectionRecordView, contains: impl Fn(&Raw) -> bool) {
+        let root = record.collection();
+        let mut state = self.roots.get(&root.raw).cloned().unwrap_or_else(|| Root::new(root));
+        if state.error.is_some() { return; }
+        let before = state.records.len();
+        let id = record.fingerprint().raw();
+        match insert_record(root, &mut state.records, record.with_native_fingerprint(id)) {
+            Err(error) => state.error = Some(Arc::from(error.to_string())),
+            Ok(()) if state.records.len() != before => {
+                let mut present = true;
+                for blob in state.references(&id) {
+                    if contains(&blob) { continue; }
+                    present = false;
+                    let mut key = [0; 96];
+                    key[..32].copy_from_slice(&blob);
+                    key[32..64].copy_from_slice(&root.raw);
+                    key[64..].copy_from_slice(&id);
+                    self.missing.insert(&Entry::new(&key));
+                }
+                if present { state.direct_present += 1; }
+            }
+            Ok(()) => {} // Duplicate frame, including identical reference aliases.
+        }
+        self.roots.replace(&Entry::with_value(&root.raw, state));
+    }
+    /// Called only on the first indexed occurrence of this blob, after it is
+    /// present in the native blob index. Finish its fanout before publishing
+    /// the frame boundary; the fanout is not a hard-latency-bounded operation.
+    pub(crate) fn blob(&mut self, blob: Raw, contains: impl Fn(&Raw) -> bool) {
+        while let Some(root) = self.missing.first_infix_range(&blob, &[0; 32], &[255; 32]) {
+            let mut prefix = [0; 64];
+            prefix[..32].copy_from_slice(&blob);
+            prefix[32..].copy_from_slice(&root);
+            let mut state = self.roots.get(&root).expect("route has canonical root").clone();
+            while let Some(id) = self.missing.first_infix_range(&prefix, &[0; 32], &[255; 32]) {
+                let mut key = [0; 96];
+                key[..64].copy_from_slice(&prefix);
+                key[64..].copy_from_slice(&id);
+                self.missing.remove(&key);
+                if state.error.is_none() && state.references(&id).iter().all(&contains) {
+                    // This was the last missing direct blob. All earlier
+                    // arrivals already consumed their routes, so M changes once.
+                    state.direct_present += 1;
+                }
+            }
+            self.roots.replace(&Entry::with_value(&root, state));
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests;
diff --git a/triblespace-core/src/collection/record_counts/tests.rs b/triblespace-core/src/collection/record_counts/tests.rs
new file mode 100644
--- /dev/null
+++ b/triblespace-core/src/collection/record_counts/tests.rs
@@ -0,0 +1,78 @@
+use super::*;
+use std::collections::BTreeSet;
+use crate::collection::{CollectionCommit, CollectionDerive, CollectionRecord, SourceLocator};
+use crate::inline::Inline;
+use ed25519_dalek::SigningKey;
+
+fn commit(root: CollectionHandle, author: u8, data: u8) -> CollectionRecordView {
+    CollectionRecord::Commit(CollectionCommit::sign(&SigningKey::from_bytes(&[author; 32]),
+        root, Inline::new([data; 32]), Inline::new([4; 32]))).into()
+}
+fn ready(n: u64, m: u64) -> RecordCountStatus {
+    RecordCountStatus::Ready { counts: DirectCounts { records: n, direct_present: m }, replay_complete: true }
+}
+#[test]
+fn duplicate_assertions_aliases_and_missing_routes_are_consumed_once() {
+    let root = Inline::new([1; 32]);
+    let mut index = RecordCountIndex::default();
+    let mut blobs = BTreeSet::from([[1; 32]]);
+    let a = commit(root, 7, 3);
+    index.record(a.clone(), |b| blobs.contains(b));
+    index.record(a, |b| blobs.contains(b));
+    index.record(commit(root, 8, 3), |b| blobs.contains(b));
+    index.record(commit(root, 9, 4), |b| blobs.contains(b)); // data == metadata
+    index.record(CollectionRecord::Derive(CollectionDerive::sign(&SigningKey::from_bytes(&[10; 32]),
+        root, SourceLocator::of([99; 32]), Inline::new([3; 32]))).into(), |b| blobs.contains(b));
+    assert_eq!(index.status(root), ready(4, 0));
+    assert_eq!(index.missing.len(), 6);
+    let old = index.clone();
+    blobs.insert([3; 32]);
+    index.blob([3; 32], |b| blobs.contains(b));
+    assert_eq!(index.status(root), ready(4, 1)); // source locator isn't a blob
+    assert_eq!(index.missing.len(), 3);
+    index.blob([3; 32], |b| blobs.contains(b));
+    assert_eq!(index.status(root), ready(4, 1));
+    blobs.insert([4; 32]);
+    index.blob([4; 32], |b| blobs.contains(b));
+    assert_eq!(index.status(root), ready(4, 4));
+    assert_eq!(index.missing.len(), 0);
+    assert_eq!(old.status(root), ready(4, 0));
+    assert_eq!(old.missing.len(), 6);
+}
+#[test]
+fn blobs_before_records_need_no_reverse_routes_and_empty_roots_are_exact() {
+    let root = Inline::new([1; 32]);
+    let mut index = RecordCountIndex::default();
+    assert_eq!(index.status(root), ready(0, 0));
+    index.record(commit(root, 7, 3), |_| true);
+    assert_eq!(index.status(root), ready(1, 1));
+    assert!(index.missing.is_empty());
+}
+#[test]
+fn canonical_collision_is_root_local_and_preserves_previous_snapshot() {
+    let bad = Inline::new([1; 32]);
+    let healthy = Inline::new([2; 32]);
+    let mut index = RecordCountIndex::default();
+    let first = commit(bad, 7, 3);
+    let fingerprint = first.fingerprint().raw();
+    index.record(first, |_| true);
+    let old = index.clone();
+    index.record(commit(bad, 8, 3).with_native_fingerprint(fingerprint), |_| true);
+    index.record(commit(healthy, 9, 3), |_| true);
+    assert!(matches!(index.status(bad), RecordCountStatus::Failed(_)));
+    assert!(index.records(bad).is_none());
+    assert_eq!(index.status(healthy), ready(1, 1));
+    assert_eq!(old.status(bad), ready(1, 1));
+}
+#[test]
+fn shared_missing_blob_updates_every_root_without_retaining_resident_routes() {
+    let mut index = RecordCountIndex::default();
+    for n in 1..=64 {
+        let root = Inline::new([n; 32]);
+        index.record(commit(root, n, 100), |b| *b != [100; 32]);
+    }
+    assert_eq!(index.missing.len(), 64);
+    index.blob([100; 32], |_| true);
+    for n in 1..=64 { assert_eq!(index.status(Inline::new([n; 32])), ready(1, 1)); }
+    assert_eq!(index.missing.len(), 0);
+}

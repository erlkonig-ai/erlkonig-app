+#[test]
+fn continuously_appending_writer_cannot_starve_exact_prefix_counts() -> Result<()> {
+    let dir = tempfile::tempdir()?;
+    let path = dir.path().join("growing-prefix-counts.pile");
+    std::fs::File::create(&path)?;
+    let key = SigningKey::from_bytes(&[42; 32]);
+    let mut writer = Pile::open(&path)?;
+    let root = writer.collection("growing prefix", private_policy(key.verifying_key()))?.handle();
+    let meta = writer.put::<blobencodings::SimpleArchive, _>(TribleSet::new())?;
+    writer.flush()?;
+    let mut reader = Pile::open_prefix(&path, 0)?;
+    // A bounded reader is deliberately fixed, so reopen the zero observation
+    // as an ordinary incremental reader for the continuously growing source.
+    let zero = reader.snapshot()?;
+    assert_eq!(zero.record_count_status(root), RecordCountStatus::Ready {
+        counts: DirectCounts::default(), replay_complete: true,
+    });
+    reader.close()?;
+    let mut reader = Pile::open(&path)?;
+    let old = reader.snapshot()?;
+    let mut largest = 0;
+    for n in 0..64 {
+        let data = writer.put::<blobencodings::UTF8String, _>(format!("arriving {n}"))?;
+        writer.insert(CollectionRecord::Commit(CollectionCommit::sign(&key, root, *data.as_transmute(), meta)))?;
+        writer.flush()?;
+        // One record boundary per turn, while the writer appends two frames.
+        let (prefix, complete) = reader.snapshot_step(1)?;
+        assert!(!complete, "writer stays ahead on every publication");
+        let expected = oracle(&prefix, root)?;
+        assert_eq!(prefix.record_count_status(root), RecordCountStatus::Ready {
+            counts: expected, replay_complete: false,
+        });
+        assert_eq!(prefix.inner().record_count_status(root), prefix.record_count_status(root));
+        largest = largest.max(expected.records);
+        let sample = StorageSnapshot::begin(prefix, &[root], &[], None).map_err(anyhow::Error::msg)?;
+        assert_eq!(sample.count_status(root), Some(RecordCountStatus::Ready {
+            counts: expected, replay_complete: false,
+        }));
+    }
+    assert!(largest >= 16, "useful exact counts publish while writer remains ahead");
+    assert_eq!(old.record_count_status(root), RecordCountStatus::Ready {
+        counts: DirectCounts::default(), replay_complete: true,
+    });
+    let end = reader.snapshot()?;
+    assert_eq!(end.record_count_status(root), RecordCountStatus::Ready {
+        counts: DirectCounts { records: 64, direct_present: 64 }, replay_complete: true,
+    });
+    reader.close()?;
+    writer.close()?;
+    Ok(())
+}

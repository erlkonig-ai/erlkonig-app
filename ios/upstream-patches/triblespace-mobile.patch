+//! Policy-independent collection-record delta mechanics.
+//!
+//! This module owns only the immutable evidence boundary: strict framing,
+//! intrinsic collection matching, ingress signature verification, canonical
+//! fingerprint ordering, and bounded `current - previous` selection. It deliberately
+//! does not resolve referenced blobs or decide READ/WRITE policy.
+//!
+//! Only foundations replicate: a collection's COMMITs and DERIVEs. A MERGE is
+//! the signing host's own lattice node; it never enters a record PATCH, is
+//! never encoded for a peer, and a peer's MERGE is refused on decode.
+
+use std::collections::BTreeSet;
+use std::error::Error;
+use std::fmt;
+use anybytes::View;
+
+use crate::collection::{
+    CollectionHandle, CollectionRead, CollectionRecord, CollectionRecordView, CollectionRecordFingerprint,
+    CollectionRecordSelector, RecordDecodeError, RecordViewChanges, EncodedCommit, EncodedDerive,
+};
+use crate::patch::{Blake3Merkle, Entry as PatchEntry, IdentitySchema, PATCH};
+
+use crate::patch::PatchSummary;
+
+/// Two canonical per-kind PATCH roots naming one exact collection.
+#[derive(Clone, Debug)]
+pub struct CollectionRecordPatch {
+    collection: CollectionHandle,
+    commits: PATCH<32, IdentitySchema, View<EncodedCommit>, Blake3Merkle>,
+    derives: PATCH<32, IdentitySchema, View<EncodedDerive>, Blake3Merkle>,
+}
+
+impl CollectionRecordPatch {
+    /// Exact collection named by every record in this PATCH.
+    pub const fn collection(&self) -> CollectionHandle {
+        self.collection
+    }
+
+    /// Independent COMMIT and DERIVE summaries, never a synthetic union root.
+    pub fn summaries(&self) -> [PatchSummary; 2] {
+        [PatchSummary::from_patch(&self.commits), PatchSummary::from_patch(&self.derives)]
+    }
+
+    /// Number of canonical records in this collection overlay.
+    pub fn len(&self) -> u64 {
+        self.commits.len() + self.derives.len()
+    }
+
+    /// Whether this collection overlay has no known records.
+    pub fn is_empty(&self) -> bool {
+        self.commits.is_empty() && self.derives.is_empty()
+    }
+
+    /// Test oracle only: production readers use kind-directed typed access.
+    #[cfg(test)]
+    pub fn get(&self, fingerprint: CollectionRecordFingerprint) -> Option<CollectionRecord> {
+        self.commits.get(&fingerprint.raw()).map(|v| CollectionRecord::Commit(v.to_record().unwrap()))
+            .or_else(|| self.derives.get(&fingerprint.raw()).map(|v| CollectionRecord::Derive(v.to_record().unwrap())))
+    }
+
+    /// The immutable COMMIT fingerprint-to-body relation.
+    pub fn commits(&self) -> &PATCH<32, IdentitySchema, View<EncodedCommit>, Blake3Merkle> {
+        &self.commits
+    }
+
+    /// The immutable DERIVE fingerprint-to-body relation.
+    pub fn derives(&self) -> &PATCH<32, IdentitySchema, View<EncodedDerive>, Blake3Merkle> {
+        &self.derives
+    }
+
+    /// Test oracle; semantic decoding is deliberately absent from serving.
+    #[cfg(test)]
+    pub fn records(&self) -> impl Iterator<Item = CollectionRecord> + '_ {
+        let mut commits = self.commits.iter_ordered().peekable();
+        let mut derives = self.derives.iter_ordered().peekable();
+        std::iter::from_fn(move || {
+            let key = match (commits.peek(), derives.peek()) {
+                (Some(c), Some(d)) if c <= d => commits.next(),
+                (Some(_), Some(_)) | (None, Some(_)) => derives.next(),
+                (Some(_), None) => commits.next(),
+                (None, None) => None,
+            }?;
+            self.get(CollectionRecordFingerprint::from_raw(*key))
+        })
+    }
+
+    pub(crate) fn empty(collection: CollectionHandle) -> Self {
+        Self { collection, commits: PATCH::new(), derives: PATCH::new() }
+    }
+
+    /// Exact bytes are checked before PATCH's key-only equality can shortcut.
+    fn matches(&self, fingerprint: CollectionRecordFingerprint, record: &CollectionRecordView) -> Option<bool> {
+        let key = fingerprint.raw();
+        if let Some(existing) = self.commits.get(&key) {
+            return Some(record.as_commit().is_some_and(|v| v.body_bytes() == existing.body_bytes()));
+        }
+        self.derives.get(&key).map(|existing| record.as_derive().is_some_and(|v| v.body_bytes() == existing.body_bytes()))
+    }
+}
+
+/// Failure while constructing an exact per-collection record PATCH.
+#[derive(Debug)]
+pub enum CollectionRecordPatchError<E> {
+    Store(E),
+    Evidence(CollectionDeltaError),
+}
+
+impl<E: fmt::Display> fmt::Display for CollectionRecordPatchError<E> {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::Store(error) => write!(f, "select collection records: {error}"),
+            Self::Evidence(error) => error.fmt(f),
+        }
+    }
+}
+
+impl<E> Error for CollectionRecordPatchError<E>
+where
+    E: Error + 'static,
+{
+    fn source(&self) -> Option<&(dyn Error + 'static)> {
+        match self {
+            Self::Store(error) => Some(error),
+            Self::Evidence(error) => Some(error),
+        }
+    }
+}
+
+/// Failure at the sparse immutable-evidence boundary.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub enum CollectionDeltaError {
+    Decode(RecordDecodeError),
+    WrongCollection,
+    /// Not a foundation (a MERGE is the signing host's own lattice node):
+    /// it never replicates.
+    NotReplicated,
+    FingerprintCollision(CollectionRecordFingerprint),
+}
+
+impl fmt::Display for CollectionDeltaError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::Decode(error) => write!(f, "decode collection record: {error}"),
+            Self::WrongCollection => write!(f, "record names another collection"),
+            Self::NotReplicated => write!(f, "only COMMIT and DERIVE records replicate"),
+            Self::FingerprintCollision(fingerprint) => {
+                write!(
+                    f,
+                    "distinct records share full-width fingerprint {fingerprint}"
+                )
+            }
+        }
+    }
+}
+
+impl Error for CollectionDeltaError {
+    fn source(&self) -> Option<&(dyn Error + 'static)> {
+        match self {
+            Self::Decode(error) => Some(error),
+            _ => None,
+        }
+    }
+}
+
+impl From<RecordDecodeError> for CollectionDeltaError {
+    fn from(error: RecordDecodeError) -> Self {
+        Self::Decode(error)
+    }
+}
+
+/// Build the exact valued PATCH of one collection's foundations through their
+/// selector.
+///
+/// This is the sole collection-overlay construction path: it never asks the
+/// caller for the store's global record stream. Backends remain free to answer
+/// the selector from a secondary index or another sparse representation.
+pub fn collection_record_patch<R>(
+    snapshot: &R,
+    collection: CollectionHandle,
+) -> Result<CollectionRecordPatch, CollectionRecordPatchError<R::RecordsError>>
+where
+    R: CollectionRead,
+{
+    if let Some(cached) = snapshot.cached_record_patch(collection) { return Ok(cached.clone()); }
+    let selectors = BTreeSet::from([CollectionRecordSelector::Foundations(collection)]);
+    let records = snapshot
+        .select_record_views(&selectors)
+        .map_err(CollectionRecordPatchError::Store)?;
+    canonical_records(collection, records).map_err(CollectionRecordPatchError::Evidence)
+}
+
+/// Advance the PATCH built from `previous` using selected append evidence or
+/// exact semantic changes; rebuild when physical sources are incomparable.
+/// `prior` must describe that previous snapshot and
+/// retains its unchanged persistent Merkle subtrees; no old record body is
+/// rehashed simply because another record arrived in its collection.
+pub fn update_collection_record_patch<R>(
+    current: &R,
+    previous: &R,
+    prior: &CollectionRecordPatch,
+) -> Result<CollectionRecordPatch, CollectionRecordPatchError<R::RecordsError>>
+where
+    R: CollectionRead,
+{
+    let expected = prior.collection;
+    if let Some(cached) = current.cached_record_patch(expected) { return Ok(cached.clone()); }
+    let selectors = BTreeSet::from([CollectionRecordSelector::Foundations(expected)]);
+    let changes = current
+        .select_record_view_changes(previous, &selectors)
+        .map_err(CollectionRecordPatchError::Store)?;
+    let (added, removed) = match changes {
+        RecordViewChanges::Append(added) => (added, Vec::new()),
+        RecordViewChanges::Delta { added, removed } => (added, removed),
+        RecordViewChanges::Rebuild => return collection_record_patch(current, expected),
+    };
+    // Operation-local deltas: edit the retained Merkle trie once per batch,
+    // rather than rehashing its wide ancestors after every changed record.
+    // PATCH equality only observes keys, so validate attached values before
+    // either structural operation can short-circuit an equal subtree.
+    let mut removals = CollectionRecordPatch::empty(expected);
+    for record in removed {
+        validate_view(expected, &record).map_err(CollectionRecordPatchError::Evidence)?;
+        let fingerprint = record.fingerprint();
+        if let Some(matches) = prior.matches(fingerprint, &record) {
+            if !matches {
+                return Err(CollectionRecordPatchError::Evidence(
+                    CollectionDeltaError::FingerprintCollision(fingerprint),
+                ));
+            }
+            insert_fingerprinted_record(&mut removals, record, fingerprint)
+                .map_err(CollectionRecordPatchError::Evidence)?;
+        }
+    }
+    let mut next = prior.clone();
+    next.commits = next.commits.difference(&removals.commits);
+    next.derives = next.derives.difference(&removals.derives);
+    let mut additions = CollectionRecordPatch::empty(expected);
+    for record in added {
+        validate_view(expected, &record).map_err(CollectionRecordPatchError::Evidence)?;
+        let fingerprint = record.fingerprint();
+        if next.matches(fingerprint, &record) == Some(false) {
+            return Err(CollectionRecordPatchError::Evidence(
+                CollectionDeltaError::FingerprintCollision(fingerprint),
+            ));
+        }
+        // Checks duplicates/collisions within this batch independently of the
+        // retained tree. Actual values, not placeholders, enter the delta.
+        insert_fingerprinted_record(&mut additions, record, fingerprint)
+            .map_err(CollectionRecordPatchError::Evidence)?;
+    }
+    next.commits.union(additions.commits);
+    next.derives.union(additions.derives);
+    Ok(next)
+}
+
+/// Encode one trusted local record after checking its intrinsic collection.
+/// Signatures are not re-verified on output. WRITE authorization is absent: it
+/// governs derived admission, not whether canonical inert evidence may exist.
+pub fn encode_record(
+    expected: CollectionHandle,
+    record: CollectionRecord,
+) -> Result<Vec<u8>, CollectionDeltaError> {
+    validate_record(expected, record)?;
+    Ok(record.to_bytes())
+}
+
+/// Strictly decode one complete self-tagged record for an implicit collection
+/// overlay. Trailing bytes, noncanonical MERGE inputs, unknown tags, wrong
+/// collections, invalid signatures and MERGE records fail before insertion.
+pub fn decode_record(
+    expected: CollectionHandle,
+    bytes: &[u8],
+) -> Result<CollectionRecord, CollectionDeltaError> {
+    let record = CollectionRecord::from_bytes(bytes)?;
+    validate_record(expected, record)?;
+    Ok(record)
+}
+
+fn validate_record(
+    expected: CollectionHandle,
+    record: CollectionRecord,
+) -> Result<(), CollectionDeltaError> {
+    if record.collection() != expected {
+        return Err(CollectionDeltaError::WrongCollection);
+    }
+    // Foundations are named positively, so a record kind added later is
+    // refused until it is listed here.
+    if !matches!(
+        record,
+        CollectionRecord::Commit(_) | CollectionRecord::Derive(_)
+    ) {
+        return Err(CollectionDeltaError::NotReplicated);
+    }
+    Ok(())
+}
+
+fn validate_view(expected: CollectionHandle, record: &CollectionRecordView) -> Result<(), CollectionDeltaError> {
+    if record.collection() != expected { return Err(CollectionDeltaError::WrongCollection); }
+    if !record.is_foundation() { return Err(CollectionDeltaError::NotReplicated); }
+    Ok(())
+}
+
+fn canonical_records<R: Into<CollectionRecordView>>(
+    expected: CollectionHandle,
+    records: impl IntoIterator<Item = R>,
+) -> Result<CollectionRecordPatch, CollectionDeltaError> {
+    let mut canonical = CollectionRecordPatch::empty(expected);
+    for record in records {
+        insert_record(expected, &mut canonical, record)?;
+    }
+    Ok(canonical)
+}
+
+pub(crate) fn insert_record(
+    expected: CollectionHandle,
+    canonical: &mut CollectionRecordPatch,
+    record: impl Into<CollectionRecordView>,
+) -> Result<(), CollectionDeltaError> {
+    let record = record.into();
+    validate_view(expected, &record)?;
+    let fingerprint = record.fingerprint();
+    insert_fingerprinted_record(canonical, record, fingerprint)
+}
+
+// The caller validated the collection/kind and computed this fingerprint for
+// this exact view. Incremental membership checks and batch insertion reuse it.
+fn insert_fingerprinted_record(
+    canonical: &mut CollectionRecordPatch,
+    record: CollectionRecordView,
+    fingerprint: CollectionRecordFingerprint,
+) -> Result<(), CollectionDeltaError> {
+    let key = fingerprint.raw();
+    if let Some(matches) = canonical.matches(fingerprint, &record) {
+        if !matches {
+            return Err(CollectionDeltaError::FingerprintCollision(fingerprint));
+        }
+        return Ok(());
+    }
+    if let Some(value) = record.as_commit() {
+        canonical.commits.insert(&PatchEntry::with_value(&key, value.clone()));
+    } else if let Some(value) = record.as_derive() {
+        canonical.derives.insert(&PatchEntry::with_value(&key, value.clone()));
+    } else {
+        unreachable!("validate_view admits only foundations");
+    }
+    Ok(())
+}
+
+#[cfg(test)]
+#[path = "collection_delta_batch_tests.rs"]
+mod batch_tests;
+
+
+#[cfg(test)]
+mod tests {
+    use std::cell::Cell;
+    use std::convert::Infallible;
+
+    use ed25519_dalek::SigningKey;
+    use crate::collection::{
+        CollectionCommit, CollectionData, CollectionDerive,
+        CollectionMerge, empty_metadata_handle,
+    };
+    use crate::inline::Inline;
+
+    use super::*;
+
+    fn collection(byte: u8) -> CollectionHandle {
+        Inline::new([byte; 32])
+    }
+
+    fn data(byte: u8) -> CollectionData {
+        Inline::new([byte; 32])
+    }
+
+    fn records(expected: CollectionHandle) -> [CollectionRecord; 3] {
+        [
+            CollectionRecord::Commit(CollectionCommit::sign(
+                &SigningKey::from_bytes(&[7; 32]),
+                expected,
+                data(1),
+                empty_metadata_handle(),
+            )),
+            CollectionRecord::Merge(
+                CollectionMerge::sign(
+                    &ed25519_dalek::SigningKey::from_bytes(&[7; 32]),
+                    expected,
+                    [2, 3, 5, 6, 7, 8, 9, 10].map(data),
+                    data(4),
+                )
+                .unwrap(),
+            ),
+            CollectionRecord::Derive(CollectionDerive::sign(
+                &ed25519_dalek::SigningKey::from_bytes(&[7; 32]),
+                expected,
+                crate::collection::SourceLocator::of(data(4).raw),
+                data(5),
+            )),
+        ]
+    }
+
+    fn foundations(expected: CollectionHandle) -> [CollectionRecord; 2] {
+        let [commit, _, derive] = records(expected);
+        [commit, derive]
+    }
+
+    #[test]
+    fn foundation_records_roundtrip_for_the_implicit_collection() {
+        let expected = collection(1);
+        for record in foundations(expected) {
+            let bytes = encode_record(expected, record).unwrap();
+            assert_eq!(decode_record(expected, &bytes).unwrap(), record);
+        }
+    }
+
+    #[test]
+    fn merge_records_are_never_encoded_decoded_or_patched() {
+        let expected = collection(1);
+        let merge = records(expected)[1];
+        assert_eq!(
+            encode_record(expected, merge),
+            Err(CollectionDeltaError::NotReplicated)
+        );
+        assert_eq!(
+            decode_record(expected, &merge.to_bytes()),
+            Err(CollectionDeltaError::NotReplicated)
+        );
+        assert!(matches!(
+            canonical_records(expected, records(expected)),
+            Err(CollectionDeltaError::NotReplicated)
+        ));
+    }
+
+    #[test]
+    fn map_records_are_never_encoded_decoded_or_patched() {
+        use crate::collection::CollectionMap;
+        let expected = collection(1);
+        let map = CollectionRecord::Map(CollectionMap::sign(
+            &SigningKey::from_bytes(&[7; 32]),
+            expected,
+            data(1),
+            data(6),
+        ));
+        // The bytes decode as a MAP: the refusal is the replication rule,
+        // not a decoding failure.
+        assert_eq!(CollectionRecord::from_bytes(&map.to_bytes()).unwrap(), map);
+        assert_eq!(
+            encode_record(expected, map),
+            Err(CollectionDeltaError::NotReplicated)
+        );
+        assert_eq!(
+            decode_record(expected, &map.to_bytes()),
+            Err(CollectionDeltaError::NotReplicated)
+        );
+        let [commit, derive] = foundations(expected);
+        assert!(matches!(
+            canonical_records(expected, [commit, map, derive]),
+            Err(CollectionDeltaError::NotReplicated)
+        ));
+    }
+
+    #[test]
+    fn framing_collection_and_signatures_fail_before_admission() {
+        let expected = collection(1);
+        let commit = records(expected)[0];
+        let bytes = encode_record(expected, commit).unwrap();
+
+        assert_eq!(
+            decode_record(collection(2), &bytes),
+            Err(CollectionDeltaError::WrongCollection)
+        );
+        for record in records(expected) {
+            // Signature checks precede the replication rule, so a tampered
+            // MERGE fails as a decode error too.
+            let mut tampered = record.to_bytes();
+            *tampered.last_mut().unwrap() ^= 1;
+            assert!(matches!(
+                decode_record(expected, &tampered),
+                Err(CollectionDeltaError::Decode(
+                    RecordDecodeError::Verification(_)
+                ))
+            ));
+        }
+        let mut trailing = bytes.clone();
+        trailing.push(0);
+        assert!(matches!(
+            decode_record(expected, &trailing),
+            Err(CollectionDeltaError::Decode(_))
+        ));
+        assert!(decode_record(expected, &bytes[..bytes.len() - 1]).is_err());
+        assert!(decode_record(expected, &[99]).is_err());
+    }
+
+    #[test]
+    fn trusted_local_index_and_outbound_encoding_do_not_reverify() {
+        use crate::collection::CollectionStore;
+        use crate::repo::pile::{Pile, PileRecordContent, PileRecords};
+
+        let expected = collection(1);
+        let record = records(expected)[2];
+        let file = tempfile::NamedTempFile::new().unwrap();
+        let mut pile = Pile::open(file.path()).unwrap();
+        pile.insert(record).unwrap();
+        pile.close().unwrap();
+        let physical = PileRecords::open(file.path())
+            .unwrap()
+            .next()
+            .unwrap()
+            .unwrap();
+        let mut bytes = std::fs::read(file.path()).unwrap();
+        bytes[physical.offset + 32 + record.to_bytes().len() - 2] ^= 1;
+        std::fs::write(file.path(), bytes).unwrap();
+        let physical = PileRecords::open(file.path())
+            .unwrap()
+            .next()
+            .unwrap()
+            .unwrap();
+        let PileRecordContent::Collection { record: evidence } = physical.content else {
+            panic!("native fixture is not a collection record");
+        };
+        assert!(evidence.verify_strict().is_err());
+        let patch = canonical_records(expected, [evidence]).unwrap();
+        let view = patch.derives().get(&evidence.fingerprint().raw()).unwrap();
+        assert_eq!(view.body_bytes(), &evidence.to_bytes());
+        let outbound = encode_record(expected, evidence).unwrap();
+        assert!(decode_record(expected, &outbound).is_err());
+    }
+
+    #[test]
+    fn derives_roundtrip_before_their_input_record_or_proofs_are_present() {
+        let signer = ed25519_dalek::SigningKey::from_bytes(&[43; 32]);
+        let source = collection(44);
+        let target = collection(45);
+        let commit = CollectionCommit::sign(&signer, source, data(46), empty_metadata_handle());
+        let derive = CollectionRecord::Derive(CollectionDerive::sign(
+            &signer,
+            target,
+            crate::collection::SourceLocator::of(commit.data().raw),
+            data(47),
+        ));
+        let bytes = encode_record(target, derive).unwrap();
+        let decoded = decode_record(target, &bytes).unwrap();
+        assert_eq!(decoded, derive);
+        // The record names the input PAYLOAD and nothing that has to arrive
+        // first. Which record produced that payload -- the commit here -- is
+        // a relation a reader recovers by content, so the derive travels
+        // alone and stays meaningful on the far side.
+        assert_eq!(canonical_records(target, [decoded]).unwrap().len(), 1);
+        let mut tampered = bytes;
+        // Every field is in the signature transcript, not an unauthenticated
+        // retrieval hint: flipping one bit of the output breaks the record.
+        tampered[2 * 32] ^= 1;
+        assert!(decode_record(target, &tampered).is_err());
+    }
+
+    #[test]
+    fn noncanonical_merge_inputs_fail_before_admission() {
+        let expected = collection(1);
+        let merge = CollectionMerge::sign(
+            &ed25519_dalek::SigningKey::from_bytes(&[7; 32]),
+            expected,
+            [2, 3, 5, 6, 7, 8, 9, 10].map(data),
+            data(4),
+        )
+        .unwrap();
+        let mut bytes = merge.to_bytes();
+        // The inputs follow kind, collection, result and author.
+        bytes[128..160].fill(9);
+        bytes[160..192].fill(1);
+        assert!(matches!(
+            decode_record(expected, &bytes),
+            Err(CollectionDeltaError::Decode(
+                RecordDecodeError::NonCanonicalMergeInputs
+            ))
+        ));
+    }
+
+    #[test]
+    fn relay_roundtrip_preserves_the_embedded_commit_author() {
+        let expected = collection(1);
+        let commit = records(expected)[0];
+        let CollectionRecord::Commit(before) = commit else {
+            unreachable!()
+        };
+        let after = decode_record(expected, &encode_record(expected, commit).unwrap()).unwrap();
+        let CollectionRecord::Commit(after) = after else {
+            unreachable!()
+        };
+        assert_eq!(after.public_key(), before.public_key());
+        assert_eq!(after, before);
+    }
+
+    struct ExactSelectorStore {
+        expected: CollectionHandle,
+        selected: Vec<CollectionRecord>,
+        global_enumerations: Cell<usize>,
+        selections: Cell<usize>,
+    }
+
+    impl CollectionRead for ExactSelectorStore {
+        type RecordsError = Infallible;
+        type RecordIter<'a> = std::vec::IntoIter<Result<CollectionRecord, Infallible>>;
+
+        fn records<'a>(&'a self) -> Result<Self::RecordIter<'a>, Self::RecordsError> {
+            self.global_enumerations
+                .set(self.global_enumerations.get() + 1);
+            Ok(Vec::new().into_iter())
+        }
+
+        fn collections(&self) -> Result<Vec<CollectionHandle>, Self::RecordsError> {
+            Ok(Vec::new())
+        }
+
+        fn select_records(
+            &self,
+            selectors: &BTreeSet<CollectionRecordSelector>,
+        ) -> Result<Vec<CollectionRecord>, Self::RecordsError> {
+            assert_eq!(
+                selectors,
+                &BTreeSet::from([CollectionRecordSelector::Foundations(self.expected)])
+            );
+            self.selections.set(self.selections.get() + 1);
+            Ok(self.selected.clone())
+        }
+    }
+
+    #[test]
+    fn overlay_patch_uses_only_the_foundations_selector() {
+        let expected = collection(1);
+        let selected = foundations(expected).to_vec();
+        let store = ExactSelectorStore {
+            expected,
+            selected: selected.clone(),
+            global_enumerations: Cell::new(0),
+            selections: Cell::new(0),
+        };
+
+        let overlay = collection_record_patch(&store, expected).unwrap();
+
+        assert_eq!(overlay.len(), selected.len() as u64);
+        assert!(
+            selected
+                .iter()
+                .all(|record| { overlay.get(record.fingerprint()) == Some(*record) })
+        );
+        assert_eq!(store.selections.get(), 1);
+        assert_eq!(store.global_enumerations.get(), 0);
+    }
+}

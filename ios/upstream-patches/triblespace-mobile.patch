+#[test]
+fn physical_duplicates_reopened_lineage_and_derive_locator() -> Result<()> {
+    let dir = tempfile::tempdir()?;
+    let path = dir.path().join("test.pile");
+    let key = SigningKey::from_bytes(&[9; 32]);
+    std::fs::File::create(&path)?;
+    let mut pile = Pile::open(&path)?;
+    let root = pile
+        .collection("derive", private_policy(key.verifying_key()))?
+        .handle();
+    let data = pile.put::<blobencodings::UTF8String, _>("output")?;
+    let absent =
+        IntoBlob::<blobencodings::UTF8String>::to_blob("locator is not a fetch").get_handle();
+    pile.insert(CollectionRecord::Derive(CollectionDerive::sign(
+        &key,
+        root,
+        SourceLocator::of(absent.raw),
+        *data.as_transmute(),
+    )))?;
+    let first = observe(pile.snapshot()?, &[root], &[], None)?;
+    assert_eq!(
+        first.counts(root),
+        Some(DirectCounts {
+            records: 1,
+            direct_present: 1
+        })
+    );
+    pile.flush()?;
+    pile.close()?;
+    let bytes = std::fs::read(&path)?;
+    use std::io::Write;
+    std::fs::OpenOptions::new()
+        .append(true)
+        .open(&path)?
+        .write_all(&bytes)?;
+    let mut reopened = Pile::open(&path)?;
+    let duplicate = observe(reopened.snapshot()?, &[root], &[], Some(&first))?;
+    assert_eq!(duplicate.counts(root), first.counts(root));
+    assert_eq!(
+        duplicate.counts(root),
+        Some(oracle(duplicate.snapshot(), root)?)
+    );
+    let rewritten_path = dir.path().join("rewritten.pile");
+    std::fs::File::create(&rewritten_path)?;
+    let mut rewritten = Pile::open(&rewritten_path)?;
+    let mut keep = triblespace_core::repo::RetentionRoots::new();
+    keep.retain_recursive(root);
+    keep.retain_direct(data);
+    reopened.rewrite_retained_into(&mut rewritten, &keep, triblespace_core::repo::pile::WantRewritePolicy::Drop)?;
+    let rewritten_snapshot = rewritten.snapshot()?;
+    assert_eq!(rewritten_snapshot.record_count_status(root), RecordCountStatus::Ready {
+        counts: oracle(&rewritten_snapshot, root)?, replay_complete: true,
+    });
+    assert_eq!(oracle(&rewritten_snapshot, root)?, first.counts(root).unwrap());
+    assert_eq!(first.counts(root).unwrap().records, 1);
+    rewritten.close()?;
+    reopened.close()?;
+    Ok(())
+}

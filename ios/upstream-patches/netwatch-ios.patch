diff --git a/netwatch/src/netmon/ios_polling.rs b/netwatch/src/netmon/ios_polling.rs
new file mode 100644
--- /dev/null
+++ b/netwatch/src/netmon/ios_polling.rs
@@ -0,0 +1,79 @@
+//! Foreground prototype fallback using public interface state, not AF_ROUTE.
+//!
+//! Every five seconds the existing actor samples State::new(), compares it to
+//! its previous state, and publishes changes. This cannot observe route-only
+//! changes or guarantee a callback while iOS suspends the application.
+
+use n0_error::stack_error;
+use n0_future::task::AbortOnDropHandle;
+use tokio::{sync::mpsc, time::{self, Duration, MissedTickBehavior}};
+
+use super::actor::NetworkMessage;
+
+#[stack_error(derive, add_meta)]
+pub struct Error;
+
+#[derive(Debug)]
+pub(super) struct RouteMonitor {
+    _handle: AbortOnDropHandle<()>,
+}
+
+impl RouteMonitor {
+    pub(super) fn new(sender: mpsc::Sender<NetworkMessage>) -> Result<Self, Error> {
+        let handle = tokio::spawn(async move {
+            let period = Duration::from_secs(5);
+            let mut ticks = time::interval_at(time::Instant::now() + period, period);
+            ticks.set_missed_tick_behavior(MissedTickBehavior::Skip);
+            loop {
+                tokio::select! {
+                    _ = sender.closed() => break,
+                    _ = ticks.tick() => {
+                        if sender.send(NetworkMessage::Change).await.is_err() {
+                            break;
+                        }
+                    }
+                }
+            }
+        });
+        Ok(Self { _handle: AbortOnDropHandle::new(handle) })
+    }
+}
+
+// Preserve all public interfaces; no assumptions about Apple interface names.
+pub(crate) fn is_interesting_interface(_name: &str) -> bool {
+    true
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn polls_and_drop_stops_the_task() {
+        tokio::runtime::Builder::new_current_thread().enable_time().build().unwrap()
+            .block_on(async {
+                let (tx, mut rx) = mpsc::channel(2);
+                let monitor = RouteMonitor::new(tx).unwrap();
+                assert!(time::timeout(Duration::from_millis(50), rx.recv()).await.is_err());
+                assert!(time::timeout(Duration::from_secs(6), rx.recv()).await.unwrap().is_some());
+                drop(monitor);
+                assert!(time::timeout(Duration::from_secs(1), rx.recv()).await.unwrap().is_none());
+            });
+    }
+
+    #[test]
+    fn closed_receiver_stops_the_task() {
+        tokio::runtime::Builder::new_current_thread().enable_time().build().unwrap()
+            .block_on(async {
+                let (tx, rx) = mpsc::channel(2);
+                let witness = tx.clone();
+                let _monitor = RouteMonitor::new(tx).unwrap();
+                drop(rx);
+                time::timeout(Duration::from_secs(1), async {
+                    while witness.strong_count() != 1 {
+                        tokio::task::yield_now().await;
+                    }
+                }).await.unwrap();
+            });
+    }
+}

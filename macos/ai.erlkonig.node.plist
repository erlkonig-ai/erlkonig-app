<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>ai.erlkonig.node</string>
	<key>BundleProgram</key>
	<string>Contents/MacOS/erlkonig-node</string>
	<!-- run --launchd: the default data folder whatever the environment says,
	     and wait for D/node.lock rather than exit when a node run by hand holds it. -->
	<key>ProgramArguments</key>
	<array>
		<string>erlkonig-node</string>
		<string>run</string>
		<string>--launchd</string>
	</array>
	<key>AssociatedBundleIdentifiers</key>
	<array>
		<string>ai.erlkonig.app</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<!-- Restart after a crash, a signal or an error exit. A clean exit (after
	     SIGTERM) is final, so a stopped node is not started again. -->
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>ExitTimeOut</key>
	<integer>15</integer>
	<!-- Chosen, not defaulted: Standard is launchd's default treatment. Background
	     would throttle CPU and I/O further, which sync with peers and maintenance
	     of a large pile should not get; Interactive is for apps the person is using. -->
	<key>ProcessType</key>
	<string>Standard</string>
</dict>
</plist>
